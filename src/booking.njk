---
layout: base.njk
title: 諮商預約｜溪水邊 Streamspsy
description: 預約溪水邊的專業諮商心理師，目前有六位優秀的心理師可供選擇，點擊預約按鈕即可直接開啟連結。
activeNav: booking
pageStyle: |
  /* ── 心理師卡片格線 ── */
  .therapist-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 600px) {
    .therapist-grid { grid-template-columns: 1fr; }
  }

  /* ── 單張卡片 ── */
  .therapist-card {
    background: #fff;
    border-radius: 1.25rem;
    padding: 0 0 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(67,52,48,0.12);
    border: 1px solid rgba(140,106,93,0.12);
    display: flex;
    flex-direction: column;
  }

  /* ── 照片區 ── */
  .tc-photo-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 1.75rem 1.5rem 1rem;
  }
  .tc-photo {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: var(--sprout);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    color: rgba(67,52,48,0.25);
    flex-shrink: 0;
  }
  .tc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tc-badge {
    position: absolute;
    bottom: 1.6rem;
    right: calc(50% - 128px);
    background: var(--rice);
    color: var(--bark);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  /* ── 名字 ── */
  .tc-name {
    text-align: center;
    color: var(--bark);
    font-size: 1.3rem;
    font-weight: 700;
    padding: 0 1.25rem 1rem;
    line-height: 1.4;
  }
  .tc-name span {
    font-size: 0.78rem;
    opacity: 0.6;
    font-weight: 400;
  }

  /* ── 標籤列 ── */
  .tc-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0 1.25rem 0.6rem;
    flex-wrap: wrap;
  }
  .tc-row-label {
    font-size: 0.72rem;
    color: rgba(67,52,48,0.5);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .tc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tc-tag-audience {
    background: var(--sprout);
    color: var(--bark);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    margin-right: 0.5rem;
  }
  .tc-tag-focus {
    background: rgb(233 255 0 / 42%);
    font-size: 0.8rem;
    padding: 0.1rem;
    display: inline-block;
    line-height: 1rem;
    margin-right: 0.5rem;
  }

  /* ── 預約按鈕 ── */
  .tc-book-btn {
    display: block;
    align-items: center;
    justify-content: space-between;
    margin: 0.75rem 1.25rem 0;
    padding: 0.65rem 1rem;
    background: var(--straw);
    color: white;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
    letter-spacing: 0.02em;
    width: 40%;
    left: 30%;
    margin-left: 30%;
    text-align: center;
  }
  .tc-book-btn:hover { background: var(--oak); color: var(--rice); transform: translateY(-1px); }
  .tc-book-btn .arrow { font-size: 0.78rem; opacity: 0.75; }
  .tc-book-btn--disabled {
    background: rgba(67,52,48,0.06);
    color: rgba(67,52,48,0.35);
    cursor: default;
    pointer-events: none;
  }
  .tc-book-btn--disabled:hover { background: rgba(67,52,48,0.06); }

  /* ── 底部連結 ── */
  .tc-footer {
    display: flex;
    border-top: 1px solid rgba(140,106,93,0.12);
    margin-top: 1.1rem;
  }
  .tc-footer a {
    flex: 1;
    text-align: center;
    padding: 0.65rem 0.5rem;
    font-size: 0.9rem;
    color: var(--oak);
    font-weight: bold;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }
  .tc-footer a:hover {
    background: rgba(67,52,48,0.04);
    color: var(--bark);
  }
  .tc-footer a + a {
    border-left: 1px solid rgba(140,106,93,0.12);
  }
  .split-layout {
    display: grid;
    grid-template-columns: 1fr 8fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.5rem 1rem;
  }

  .split-left {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    grid-row: 1 / 3; /* 跨兩列 */
    border-radius: 0.75rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--oak);
    color: white;
    padding: 1rem;
  }

  .split-right-top {
    border-radius: 0.75rem;
  }

  .split-right-bottom {
    border-radius: 0.75rem;
  }
---

<!-- ══════════════ PAGE HERO ══════════════ -->
<div class="page-hero">
  <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.booking_hero_label }}</p>
  <h1>{{ ui.booking_hero_title }}</h1>
  <p>{{ ui.booking_hero_subtitle }}</p>
</div>

<!-- ══════════════ 主體 ══════════════ -->
<section class="py-section">
  <div class="content-max">

      <!-- 心理師卡片格線 -->
      <div class="therapist-grid" aria-label="心理師列表">

        {% for t in therapists %}
        <article class="therapist-card">
          <div class="tc-photo-wrap">
            {% if t.photo %}
              <img src="{{ t.photo }}" alt="{{ t.name }}" class="tc-photo" style="object-fit:cover;">
            {% else %}
              <div class="tc-photo" aria-hidden="true">👤</div>
            {% endif %}
            {% if t.badge %}<span class="tc-badge">{{ t.badge }}</span>{% endif %}
          </div>
          <div class="tc-name">{{ t.name }} {{ t.title }}</div>
          <div class="tc-row">
            <div class="split-layout">
              <div class="split-left">服務對象</div>
              <div class="split-right-top">
                {% for a in t.audiences %}<span class="tc-tag-audience">{{ a }}</span>{% endfor %}
              </div>
              <div class="split-right-bottom">
                {% for f in t.focuses %}<span class="tc-tag-focus">#{{ f }}</span>{% endfor %}
              </div>
            </div>
          </div>
          {% if t.status === '開放預約' and t.bookingLink %}
            <a href="{{ t.bookingLink }}" class="tc-book-btn" target="_blank" rel="noopener">
              <span>預約點我</span>
            </a>
          {% elif t.status === '即將開放' %}
            <span class="tc-book-btn tc-book-btn--disabled" aria-disabled="true">
              <span>預約即將開放</span>
              <span class="arrow">敬請期待</span>
            </span>
          {% else %}
            <span class="tc-book-btn tc-book-btn--disabled" aria-disabled="true">
              <span>資料建置中</span>
            </span>
          {% endif %}
          <div class="tc-footer">
            <a href="{{ t.articlesUrl | url }}">
              <span>📖</span> 專業文章
            </a>
            <a href="{{ t.mediaUrl | url }}">
              <span>🎙</span> 系列作品
            </a>
          </div>
        </article>
        {% endfor %}

      </div><!-- /.therapist-grid -->
  </div>
</section>
