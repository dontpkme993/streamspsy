activeNav: booking
pageStyle: |
  /* ── 整體佈局 ── */
  .booking-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .booking-layout { grid-template-columns: 1fr; }
  }

  /* ── 說明欄 ── */
  .booking-intro {
    position: sticky;
    top: 6rem;
    background: #fff;
    border: 1px solid rgba(140,106,93,0.18);
    border-radius: 1rem;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 2px 12px rgba(67,52,48,0.06);
    font-size: 0.92rem;
    line-height: 1.95;
    color: rgba(67,52,48,0.82);
  }
  .booking-intro h2 {
    font-size: 1rem;
    color: var(--bark);
    margin-bottom: 0.75rem;
  }
  @media (max-width: 860px) {
    .booking-intro { position: static; }
  }

  /* ── 心理師卡片格線 ── */
  .therapist-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 600px) {
    .therapist-grid { grid-template-columns: 1fr; }
  }

  /* ── 單張卡片 ── */
  .therapist-card {
    background: #728B62;
    border-radius: 1.25rem;
    padding: 0 0 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(67,52,48,0.15);
    display: flex;
    flex-direction: column;
  }

  /* ── 照片區 ── */
  .tc-photo-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 1.75rem 1.5rem 1rem;
  }
  .tc-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 3px solid #C8A96E;
    background: rgba(255,255,255,0.15);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: rgba(255,255,255,0.5);
    flex-shrink: 0;
  }
  .tc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tc-badge {
    position: absolute;
    bottom: 0.6rem;
    right: calc(50% - 72px);
    background: #C8A96E;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  /* ── 名字 ── */
  .tc-name {
    text-align: center;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 700;
    padding: 0 1.25rem 1rem;
    line-height: 1.4;
  }
  .tc-name span {
    font-size: 0.78rem;
    opacity: 0.75;
    font-weight: 400;
  }

  /* ── 標籤列 ── */
  .tc-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0 1.25rem 0.6rem;
    flex-wrap: wrap;
  }
  .tc-row-label {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.7);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .tc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tc-tag-audience {
    background: rgba(255,255,255,0.82);
    color: #5C6B4A;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .tc-tag-focus {
    background: rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.92);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.3);
  }

  /* ── 預約按鈕 ── */
  .tc-book-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0.75rem 1.25rem 0;
    padding: 0.7rem 1rem;
    background: #C4703C;
    color: #fff;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
    letter-spacing: 0.02em;
  }
  .tc-book-btn:hover { background: #A85C2E; color: #fff; }
  .tc-book-btn .arrow { font-size: 0.8rem; opacity: 0.85; }
  .tc-book-btn--disabled {
    background: rgba(255,255,255,0.15);
    cursor: default;
    pointer-events: none;
  }
  .tc-book-btn--disabled:hover { background: rgba(255,255,255,0.15); }

  /* ── 底部連結 ── */
  .tc-footer {
    display: flex;
    border-top: 1px solid rgba(255,255,255,0.15);
    margin-top: 1.1rem;
  }
  .tc-footer a {
    flex: 1;
    text-align: center;
    padding: 0.7rem 0.5rem;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }
  .tc-footer a:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }
  .tc-footer a + a {
    border-left: 1px solid rgba(255,255,255,0.15);
  }
