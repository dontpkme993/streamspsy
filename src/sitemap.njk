---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ '/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}{{ '/about/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}{{ '/articles/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for article in articles %}
  <url>
    <loc>{{ site.url }}{{ ('/articles/' + article.slug + '/') | url }}</loc>
    <lastmod>{{ article.date or site.buildDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  <url>
    <loc>{{ site.url }}{{ '/events/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}{{ '/media/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}{{ '/cards/' | url }}</loc>
    <lastmod>{{ site.buildDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
