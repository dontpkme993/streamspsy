<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StreamsPsy — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

    :root{
      --bg:#0c0f14;
      --surface:rgba(255,255,255,.04);
      --text:#e8e6e1;
      --text-dim:rgba(232,230,225,.45);
      --accent:#7eb8a2;
      --accent-glow:rgba(126,184,162,.15);
      --serif:'DM Serif Display',Georgia,serif;
      --sans:'Outfit',system-ui,sans-serif;
    }

    html{font-size:16px}
    body{
      min-height:100dvh;
      display:flex;
      align-items:center;
      justify-content:center;
      background:var(--bg);
      color:var(--text);
      font-family:var(--sans);
      overflow:hidden;
      position:relative;
    }

    /* ambient background */
    body::before{
      content:'';
      position:fixed;
      inset:0;
      background:
        radial-gradient(ellipse 60% 50% at 20% 30%,rgba(126,184,162,.08) 0%,transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 70%,rgba(100,140,180,.06) 0%,transparent 70%);
      pointer-events:none;
      animation:ambientShift 12s ease-in-out infinite alternate;
    }

    @keyframes ambientShift{
      0%{opacity:.7;transform:scale(1)}
      100%{opacity:1;transform:scale(1.05)}
    }

    /* floating orbs */
    .orb{
      position:fixed;
      border-radius:50%;
      filter:blur(80px);
      pointer-events:none;
      opacity:.35;
    }
    .orb-1{
      width:300px;height:300px;
      background:rgba(126,184,162,.2);
      top:10%;left:5%;
      animation:float1 18s ease-in-out infinite;
    }
    .orb-2{
      width:250px;height:250px;
      background:rgba(100,140,200,.15);
      bottom:15%;right:10%;
      animation:float2 22s ease-in-out infinite;
    }
    .orb-3{
      width:180px;height:180px;
      background:rgba(180,140,200,.1);
      top:50%;left:60%;
      animation:float3 15s ease-in-out infinite;
    }

    @keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(30px,-40px)}}
    @keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(-25px,35px)}}
    @keyframes float3{0%,100%{transform:translate(0,0)}50%{transform:translate(-20px,-30px)}}

    /* grain overlay */
    body::after{
      content:'';
      position:fixed;
      inset:0;
      background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E");
      pointer-events:none;
      z-index:100;
    }

    /* main content */
    .container{
      position:relative;
      z-index:10;
      text-align:center;
      padding:2rem;
      max-width:600px;
      animation:fadeUp .8s ease-out both;
    }

    @keyframes fadeUp{
      from{opacity:0;transform:translateY(24px)}
      to{opacity:1;transform:translateY(0)}
    }

    /* logo mark */
    .logo-mark{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      width:64px;height:64px;
      border-radius:16px;
      background:var(--surface);
      border:1px solid rgba(255,255,255,.06);
      margin-bottom:2.5rem;
      animation:fadeUp .8s ease-out .15s both;
      backdrop-filter:blur(12px);
    }
    .logo-mark svg{
      width:30px;height:30px;
      stroke:var(--accent);
      fill:none;
      stroke-width:1.5;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .title{
      font-family:var(--serif);
      font-size:clamp(2.4rem,6vw,3.6rem);
      font-weight:400;
      letter-spacing:-.02em;
      line-height:1.15;
      margin-bottom:.75rem;
      animation:fadeUp .8s ease-out .25s both;
    }
    .title span{
      color:var(--accent);
    }

    .tagline{
      font-size:1.05rem;
      font-weight:300;
      color:var(--text-dim);
      line-height:1.6;
      margin-bottom:3rem;
      animation:fadeUp .8s ease-out .35s both;
    }

    /* divider */
    .divider{
      width:48px;
      height:1px;
      background:linear-gradient(90deg,transparent,var(--accent),transparent);
      margin:0 auto 2.5rem;
      animation:fadeUp .8s ease-out .4s both;
    }

    .status{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.6rem 1.2rem;
      border-radius:100px;
      background:var(--surface);
      border:1px solid rgba(255,255,255,.06);
      font-size:.85rem;
      font-weight:400;
      color:var(--text-dim);
      letter-spacing:.03em;
      backdrop-filter:blur(12px);
      animation:fadeUp .8s ease-out .5s both;
    }
    .status-dot{
      width:7px;height:7px;
      border-radius:50%;
      background:var(--accent);
      box-shadow:0 0 8px var(--accent);
      animation:pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse{
      0%,100%{opacity:.5;transform:scale(1)}
      50%{opacity:1;transform:scale(1.2)}
    }

    /* bottom info */
    .footer{
      position:fixed;
      bottom:2rem;
      left:0;right:0;
      text-align:center;
      font-size:.75rem;
      color:rgba(232,230,225,.2);
      letter-spacing:.06em;
      z-index:10;
    }
  </style>
</head>
<body>

  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <div class="container">
    <div class="logo-mark">
      <svg viewBox="0 0 24 24">
        <path d="M12 3c-1.5 2-4 4-4 7a4 4 0 0 0 8 0c0-3-2.5-5-4-7Z"/>
        <path d="M12 14v4"/>
        <path d="M9 18h6"/>
      </svg>
    </div>

    <h1 class="title">Streams<span>Psy</span></h1>
    <p class="tagline">網站正在準備中，即將與您見面。</p>

    <div class="divider"></div>

    <div class="status">
      <span class="status-dot"></span>
      Coming Soon
    </div>
  </div>

  <div class="footer">STREAMSPSY.COM</div>

</body>
</html>
