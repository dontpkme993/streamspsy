---
layout: base.njk
title: 專欄文章｜溪水邊 Streamspsy
description: 溪水邊 Streamspsy 專欄文章 — 關於心理、繪本與租書店觀察的深度閱讀。
activeNav: articles
jsonLd: |
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "溪水邊專欄",
    "description": "關於心理諮商、兒童閱讀與書店觀察的深度文章",
    "url": "https://streamspsy.com/articles/",
    "author": {
      "@type": "Person",
      "name": "溪水邊創辦人"
    }
  }
pageStyle: |
  .sidebar-sticky { position: sticky; top: 88px; }
pageScript: |
  <script>
    // Filter driven by URL hash
    // Formats: '' (all), '#tag=心理', '#author=江玲承'

    function parseHash() {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h) return { type: 'all', value: '' };
      if (h.startsWith('tag=')) return { type: 'tag', value: h.slice(4) };
      if (h.startsWith('author=')) return { type: 'author', value: h.slice(7) };
      return { type: 'tag', value: h }; // legacy bare tag
    }

    function applyFilter(filter) {
      const { type, value } = filter;

      // Update heading
      const heading = document.getElementById('article-list-heading');
      if (heading) {
        if (type === 'all') heading.textContent = '顯示所有文章';
        else if (type === 'tag') heading.textContent = '標籤：#' + value;
        else heading.textContent = '作者：' + value;
      }

      // Update author buttons
      document.querySelectorAll('.author-btn').forEach(b => {
        b.classList.toggle('active', type === 'author' && b.dataset.author === value);
      });

      // Collect tags from filtered articles when filtering by author
      let activeTags = new Set();
      if (type === 'author') {
        document.querySelectorAll('.article-card').forEach(card => {
          if ((card.dataset.authors || '').split('|||').includes(value)) {
            const cardTags = (card.dataset.tags || '').split(/\s+/).filter(t => t);
            cardTags.forEach(tag => activeTags.add(tag));
          }
        });
      }

      // Update tag buttons
      document.querySelectorAll('.tag-btn').forEach(b => {
        const isAll = b.dataset.tag === 'all';
        let shouldBeActive;
        if (type === 'all') {
          shouldBeActive = isAll;
        } else if (type === 'tag') {
          shouldBeActive = isAll ? false : (b.dataset.tag === value);
        } else {
          // type === 'author': show tags that this author has written
          shouldBeActive = activeTags.has(b.dataset.tag);
        }
        b.classList.toggle('active', shouldBeActive);
      });

      // Filter articles
      document.querySelectorAll('.article-card').forEach(card => {
        let show;
        if (type === 'all') {
          show = true;
        } else if (type === 'tag') {
          show = (card.dataset.tags || '').includes(value);
        } else {
          show = (card.dataset.authors || '').split('|||').includes(value);
        }
        card.style.display = show ? '' : 'none';
      });
    }

    // Author button clicks
    document.querySelectorAll('.author-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        location.hash = 'author=' + encodeURIComponent(btn.dataset.author);
      });
    });

    // Tag button clicks
    document.querySelectorAll('.tag-btn:not(.author-btn)').forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        location.hash = tag === 'all' ? '' : 'tag=' + encodeURIComponent(tag);
      });
    });

    window.addEventListener('hashchange', () => applyFilter(parseHash()));
    applyFilter(parseHash());

    // Show sidebar on desktop
    function updateSidebar() {
      const sidebar = document.querySelector('aside');
      sidebar.style.display = window.innerWidth >= 1024 ? 'block' : 'none';
    }
    updateSidebar();
    window.addEventListener('resize', updateSidebar);
  </script>
---

<!-- ══════════════ PAGE HERO ══════════════ -->
<div class="page-hero">
  <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.articles_hero_label }}</p>
  <h1>{{ ui.articles_hero_title }}</h1>
  <p>{{ ui.articles_hero_subtitle }}</p>
</div>

<!-- ══════════════ FILTER ══════════════ -->
<div style="max-width:1100px;margin:0 auto;padding:0 1.5rem 2.5rem;" role="search" aria-label="文章篩選">
  {% if articleAuthors.length %}
  <p style="font-size:0.8rem;color:rgba(67,52,48,0.5);margin-bottom:0.75rem;letter-spacing:0.05em;">{{ ui.articles_author_filter_label }}</p>
  <div style="display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:1.5rem;" id="author-filter">
    {% for name in articleAuthors %}
      <button class="tag-btn author-btn" data-author="{{ name }}">{{ name }}</button>
    {% endfor %}
  </div>
  {% endif %}
  <p style="font-size:0.8rem;color:rgba(67,52,48,0.5);margin-bottom:0.75rem;letter-spacing:0.05em;">{{ ui.articles_filter_label }}</p>
  <div style="display:flex;flex-wrap:wrap;gap:0.6rem;" id="tag-filter">
    <button class="tag-btn active" data-tag="all">{{ ui.articles_all_btn }}</button>
    {% for item in articleTags %}
      <button class="tag-btn" data-tag="{{ item.tag }}">#{{ item.tag }}</button>
    {% endfor %}
  </div>
</div>

<!-- ══════════════ SIDEBAR LAYOUT ══════════════ -->
<div class="sidebar-layout" style="padding-bottom:5rem;">

  <!-- ── ARTICLE LIST ── -->
  <section aria-labelledby="article-list-heading">
    <h2 id="article-list-heading" style="font-size:1rem;color:rgba(67,52,48,0.4);letter-spacing:0.08em;margin-bottom:1.5rem;font-weight:400;">顯示所有文章</h2>

    {% if articles.length %}
      {% for article in articles %}
        <article class="article-card" data-tags="{{ article.tags | join(' ') }}" data-authors="{{ article.authors | join('|||') }}">
          <a href="{{ ('/articles/' + article.slug + '/') | url }}" class="article-thumb" style="display:block;text-decoration:none;">
            {% if article.image %}
              <img src="{{ article.image | url }}" alt="{{ article.title }}" style="width:100%;height:100%;object-fit:cover;">
            {% else %}
              <span>封面圖<br>Placeholder</span>
            {% endif %}
          </a>
          <div class="article-body">
            <p class="date">{{ article.date | dateDisplay }}</p>
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem;">
              {% for tag in article.tags %}
                <span class="tag">#{{ tag }}</span>
              {% endfor %}
            </div>
            <h3><a href="{{ ('/articles/' + article.slug + '/') | url }}" style="color:inherit;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--straw)'" onmouseout="this.style.color='inherit'">{{ article.title }}</a></h3>
            <p class="summary-label">3 秒摘要</p>
            <p class="summary">{{ article.summary }}</p>
            <a href="{{ ('/articles/' + article.slug + '/') | url }}" style="display:inline-block;margin-top:0.75rem;font-size:0.82rem;color:var(--straw);font-weight:600;letter-spacing:0.04em;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">閱讀全文 →</a>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <!-- Placeholder articles shown when Notion is not connected -->
      <article class="article-card" data-tags="心理 自我探索">
        <div class="article-thumb">
          <span>封面圖<br>Placeholder</span>
        </div>
        <div class="article-body">
          <p class="date">2026年3月28日</p>
          <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem;">
            <span class="tag">#心理</span>
            <span class="tag">#自我探索</span>
          </div>
          <h3><span class="placeholder-text">文章標題一 Article Title 1 Placeholder — 關於自我探索的深度文章</span></h3>
          <p class="summary-label">3 秒摘要</p>
          <p class="summary"><span class="placeholder-text">文章重點摘要佔位符：讀者能在3秒內理解本文核心價值。3-second summary for AEO: the key takeaway a reader needs before deciding to read on. Article Excerpt Placeholder.</span></p>
        </div>
      </article>

      <article class="article-card" data-tags="繪本 親子">
        <div class="article-thumb">
          <span>封面圖<br>Placeholder</span>
        </div>
        <div class="article-body">
          <p class="date">2026年3月15日</p>
          <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem;">
            <span class="tag">#繪本</span>
