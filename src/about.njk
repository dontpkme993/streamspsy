---
layout: base.njk
title: 關於我們｜溪水邊 Streamspsy
description: 認識溪水邊 Streamspsy — 專業諮商師的背景故事、核心價值與品牌哲學。
activeNav: about
jsonLd: |
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "溪水邊創辦人",
    "jobTitle": "諮商心理師",
    "description": "透過專業諮商、兒童閱讀與租書店的一手觀察，找回生活最溫暖的樣子。",
    "url": "https://streamspsy.com/about/",
    "sameAs": []
  }
---

<!-- ══════════════ PAGE HERO ══════════════ -->
<div class="page-hero">
  <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw-text);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.about_hero_label }}</p>
  <h1>{{ ui.about_hero_title }}</h1>
  <p>{{ ui.about_hero_subtitle }}</p>
</div>

<!-- ══════════════ BRAND PHILOSOPHY ══════════════ -->
<section class="py-section" aria-labelledby="philosophy-heading">
  <div class="content-max" style="max-width:800px;">
    <h2 id="philosophy-heading" style="font-size:clamp(1.8rem,3.5vw,2.8rem);margin-bottom:1.5rem;line-height:1.35;">
      {% if ui.about_philosophy_title %}{{ ui.about_philosophy_title }}{% else %}<span class="placeholder-text">品牌哲學 標題</span>{% endif %}
    </h2>
    <p style="font-size:1.05rem;color:rgba(67,52,48,0.72);line-height:2;font-style:italic;border-left:3px solid var(--straw);padding-left:1.5rem;">
      {% if ui.about_philosophy_quote %}{{ ui.about_philosophy_quote }}{% else %}<span class="placeholder-text">品牌哲學 引言</span>{% endif %}
    </p>
  </div>
</section>

<div class="divider" style="margin:0 1.5rem;"></div>

<!-- ══════════════ ZIG-ZAG: Bio ══════════════ -->
<section class="py-section" aria-labelledby="bio-heading">
  <div class="content-max">
    <div class="zigzag-block">
      {% if siteImages.FOUNDER_PORTRAIT %}
        <img src="{{ siteImages.FOUNDER_PORTRAIT }}" alt="{{ ui.about_founder_title }}"
          style="width:100%;height:400px;object-fit:cover;object-position:top;border-radius:1rem;display:block;">
      {% else %}
        <div class="img-placeholder" style="height:400px;border-radius:1rem;">
          <span>專業形象圖<br>Professional Portrait<br>Image Placeholder</span>
        </div>
      {% endif %}
      <div>
        <p style="font-size:0.8rem;letter-spacing:0.15em;color:var(--straw-text);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.about_founder_label }}</p>
        <h2 id="bio-heading" style="font-size:1.8rem;margin-bottom:1.5rem;">{{ ui.about_founder_title }}</h2>
        <div style="font-size:0.95rem;color:rgba(67,52,48,0.78);line-height:2;display:flex;flex-direction:column;gap:1rem;">
          <p>{% if ui.about_bio_1 %}{{ ui.about_bio_1 }}{% else %}<span class="placeholder-text">個人簡介 第一段</span>{% endif %}</p>
          <p>{% if ui.about_bio_2 %}{{ ui.about_bio_2 }}{% else %}<span class="placeholder-text">個人簡介 第二段</span>{% endif %}</p>
          <p>{% if ui.about_bio_3 %}{{ ui.about_bio_3 }}{% else %}<span class="placeholder-text">個人簡介 第三段</span>{% endif %}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="divider" style="margin:0 1.5rem;"></div>

<!-- ══════════════ CORE VALUES ══════════════ -->
<section class="py-section" aria-labelledby="values-heading">
  <div class="content-max">
    <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw-text);margin-bottom:0.5rem;text-transform:uppercase;text-align:center;">{{ ui.about_values_label }}</p>
    <h2 class="section-title" id="values-heading" style="text-align:center;margin-bottom:0.5rem;">{{ ui.about_values_title }}</h2>
    <p class="section-subtitle" style="text-align:center;">{{ ui.about_values_subtitle }}</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2rem;margin-top:1rem;">

      <article class="reveal" style="text-align:center;padding:2.5rem 2rem;background:white;border-radius:1rem;box-shadow:0 2px 16px rgba(140,106,93,0.07);">
        <div style="width:64px;height:64px;background:linear-gradient(135deg,var(--sprout),var(--straw));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.75rem;margin:0 auto 1.25rem;">🌊</div>
        <h3 style="font-size:1.05rem;margin-bottom:0.75rem;">{{ ui.about_v1_title }}</h3>
        <p style="font-size:0.85rem;color:rgba(67,52,48,0.68);line-height:1.8;">{% if ui.about_v1_desc %}{{ ui.about_v1_desc }}{% else %}<span class="placeholder-text">價值一 說明</span>{% endif %}</p>
      </article>

      <article class="reveal" style="text-align:center;padding:2.5rem 2rem;background:white;border-radius:1rem;box-shadow:0 2px 16px rgba(140,106,93,0.07);">
        <div style="width:64px;height:64px;background:linear-gradient(135deg,var(--sprout),var(--straw));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.75rem;margin:0 auto 1.25rem;">📖</div>
        <h3 style="font-size:1.05rem;margin-bottom:0.75rem;">{{ ui.about_v2_title }}</h3>
        <p style="font-size:0.85rem;color:rgba(67,52,48,0.68);line-height:1.8;">{% if ui.about_v2_desc %}{{ ui.about_v2_desc }}{% else %}<span class="placeholder-text">價值二 說明</span>{% endif %}</p>
      </article>

      <article class="reveal" style="text-align:center;padding:2.5rem 2rem;background:white;border-radius:1rem;box-shadow:0 2px 16px rgba(140,106,93,0.07);">
        <div style="width:64px;height:64px;background:linear-gradient(135deg,var(--sprout),var(--straw));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.75rem;margin:0 auto 1.25rem;">🏡</div>
        <h3 style="font-size:1.05rem;margin-bottom:0.75rem;">{{ ui.about_v3_title }}</h3>
        <p style="font-size:0.85rem;color:rgba(67,52,48,0.68);line-height:1.8;">{% if ui.about_v3_desc %}{{ ui.about_v3_desc }}{% else %}<span class="placeholder-text">價值三 說明</span>{% endif %}</p>
      </article>

    </div>
  </div>
</section>

<div class="divider" style="margin:0 1.5rem;"></div>

<!-- ══════════════ CERTIFICATIONS ══════════════ -->
<section class="py-section" aria-labelledby="cert-heading">
  <div class="content-max" style="max-width:800px;">
    <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw-text);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.about_cert_label }}</p>
    <h2 class="section-title" id="cert-heading" style="margin-bottom:2rem;">{{ ui.about_cert_title }}</h2>

    <ul style="list-style:none;display:flex;flex-direction:column;gap:1rem;" role="list">
      {% for i in [1,2,3,4,5] %}
        {% set certKey = 'about_cert_' + i %}
        {% if ui[certKey] %}
        <li style="display:flex;gap:1rem;align-items:flex-start;padding:1.25rem;background:white;border-radius:0.75rem;box-shadow:0 1px 8px rgba(140,106,93,0.06);">
          <span style="color:var(--straw);font-size:1.1rem;margin-top:0.1rem;">◆</span>
          <span style="font-size:0.9rem;color:rgba(67,52,48,0.8);">{{ ui[certKey] }}</span>
        </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<!-- ══════════════ CTA ══════════════ -->
<div class="content-max" style="padding-bottom:5rem;">
  <div class="cta-block">
    <h2 style="font-size:1.6rem;margin-bottom:0.75rem;">{{ ui.about_cta_title }}</h2>
    <p style="color:rgba(67,52,48,0.7);margin-bottom:2rem;">{{ ui.about_cta_desc }}</p>
    <a href="{{ '/events/' | url }}" class="btn-primary">{{ ui.about_cta_btn }}</a>
  </div>
</div>
