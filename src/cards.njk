---
layout: base.njk
title: 為自己抽張卡｜溪水邊 Streamspsy
description: 溪水邊 Streamspsy 為自己抽張卡 — 一張牌卡，一個當下，讓直覺帶你看見今天需要的那道光。
activeNav: cards
pageToast: true
pageStyle: |
  body { background: var(--rice); }

  /* Share toast */
  .toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--oak);
    color: var(--rice);
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 999;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .toast.show { transform: translateX(-50%) translateY(0); }

  /* Fade-in animation */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Fan Layout ── */
  .card-fan {
    position: relative;
    width: min(240px, 64vw);
    height: min(360px, 54vw + 110px);
    margin: 0 auto 6rem; /* bottom space for arc overflow */
  }

  .fan-card {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    cursor: pointer;
    transform-origin: 50% 130%;
    transform: rotate(0deg);
    transition: transform 0.55s cubic-bezier(0.34, 1.15, 0.64, 1);
    border-radius: 1.25rem;
    will-change: transform;
  }

  .fan-card.spread {
    transform: rotate(var(--fan-angle, 0deg));
  }

  .fan-card.hovered {
    transform: rotate(var(--fan-angle, 0deg)) translateY(-48px) scale(1.06);
    transition: transform 0.18s ease-out;
  }

  .fan-card.collapsing {
    transform: rotate(0deg);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .fan-card-back {
    width: 100%; height: 100%;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--oak) 0%, #6b4f45 50%, var(--bark) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--rice);
    position: relative;
    box-shadow: 0 16px 48px rgba(140,106,93,0.22);
    pointer-events: none;
  }

  .fan-card-back::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1.5px solid rgba(250,243,224,0.22);
    border-radius: 0.85rem;
  }

  .fan-card-back .card-pattern {
    font-size: 2.2rem;
    opacity: 0.45;
  }

  /* Result card — hidden until a fan card is clicked */
  #cardResultWrap {
    display: none;
    margin-bottom: 2.5rem;
  }

pageScript: |
  <script>

    // Calculate fan angles dynamically so outermost card stays within viewport
    function calcFanAngles() {
      const W = window.innerWidth;
      const cardW = Math.min(240, W * 0.64);
      const cardH = Math.min(360, W * 0.54 + 110);
      const radius = cardH * 1.12; // pivot is 12% below card bottom (matches transform-origin)
      const available = W / 2 - 16; // leave 16px margin from each edge

      // Binary search for the largest angle whose outermost card edge fits within 'available'
      let lo = 0, hi = Math.PI / 2;
      for (let i = 0; i < 40; i++) {
        const mid = (lo + hi) / 2;
        const extent = Math.sin(mid) * radius + (cardW / 2) * Math.cos(mid);
        if (extent <= available) lo = mid; else hi = mid;
      }
      const maxDeg = Math.min(40, Math.max(5, lo * 180 / Math.PI));

      // 10 cards evenly from -maxDeg to +maxDeg
      return Array.from({length: 10}, (_, i) =>
        +(-maxDeg + i * (2 * maxDeg / 9)).toFixed(1)
      );
    }
    const FAN_ANGLES = calcFanAngles();
    let fanState = 'fan'; // 'fan' | 'collapsing' | 'result'
    let selectedCardIndex = -1;

    function buildFan() {
      const fan = document.getElementById('cardFan');
      fan.innerHTML = '';
      FAN_ANGLES.forEach((angle, i) => {
        const el = document.createElement('div');
        el.className = 'fan-card';
        el.style.setProperty('--fan-angle', angle + 'deg');
        el.setAttribute('role', 'button');
        el.setAttribute('tabindex', '0');
        el.setAttribute('aria-label', '翻牌 ' + (i + 1));
        el.innerHTML = '<div class="fan-card-back"><span class="card-pattern" aria-hidden="true">✦</span></div>';

        el.addEventListener('mouseenter', () => {
          if (fanState !== 'fan') return;
          el.classList.add('hovered');
        });
        el.addEventListener('mouseleave', () => el.classList.remove('hovered'));
        el.addEventListener('click', () => { if (fanState === 'fan') pickCard(); });
        el.addEventListener('keydown', e => {
          if ((e.key === 'Enter' || e.key === ' ') && fanState === 'fan') pickCard();
        });

        fan.appendChild(el);
      });
    }

    function showFan() {
      fanState = 'fan';
      selectedCardIndex = -1;
      document.getElementById('cardFan').style.display = '';
      document.getElementById('cardResultWrap').style.display = 'none';
      document.getElementById('card3d').classList.remove('flipped');
      document.getElementById('interpretation').classList.remove('visible');

      // Trigger spread animation after paint
      requestAnimationFrame(() => requestAnimationFrame(() => {
        document.querySelectorAll('.fan-card').forEach(c => c.classList.add('spread'));
      }));
    }

    function showCardResult(cardIndex, animate) {
      selectedCardIndex = cardIndex;
      const card = CARDS[cardIndex];

      const emojiEl = document.getElementById('cardEmoji');
      if (card.image) {
        emojiEl.innerHTML = '<img src="' + card.image + '" alt="" aria-hidden="true">';
      } else {
        emojiEl.textContent = '✨';
      }
      document.getElementById('cardTitle').textContent = card.title;
      document.getElementById('cardKeyword').textContent = card.keyword;
      document.getElementById('interpretTitle').textContent = card.interpretTitle;
      document.getElementById('interpretBody').textContent = card.interpretBody;
      document.getElementById('interpretMessage').textContent = '「' + card.interpretMessage + '」';
      document.getElementById('cardTags').innerHTML = (card.tags || []).map(function(t) { return '<span class="tag">#' + t + '</span>'; }).join('');
      var tags = card.tags || [];
      var randomTag = tags.length ? tags[Math.floor(Math.random() * tags.length)] : '';
      document.getElementById('articlesBtn').href = '/articles/' + (randomTag ? '#tag=' + encodeURIComponent(randomTag) : '');

      // Update hash (without adding a history entry)
      history.replaceState(null, '', '#' + encodeURIComponent(card.interpretTitle));

      const resultWrap = document.getElementById('cardResultWrap');
      resultWrap.style.display = 'block';
      void resultWrap.offsetHeight;

      if (animate) {
        setTimeout(() => {
          document.getElementById('card3d').classList.add('flipped');
          fanState = 'result';
          setTimeout(() => {
            const interp = document.getElementById('interpretation');
            interp.classList.add('visible');
            interp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 650);
        }, 40);
      } else {
        document.getElementById('card3d').classList.add('flipped');
        fanState = 'result';
        document.getElementById('interpretation').classList.add('visible');
      }
    }

    function pickCard() {
      if (fanState !== 'fan') return;
      fanState = 'collapsing';

      document.querySelectorAll('.fan-card').forEach(c => {
        c.classList.remove('hovered', 'spread');
        c.classList.add('collapsing');
      });

      const cardIndex = Math.floor(Math.random() * CARDS.length);

      setTimeout(() => {
        document.getElementById('cardFan').style.display = 'none';
        showCardResult(cardIndex, true);
      }, 450);
    }

    function redraw() {
      history.replaceState(null, '', location.pathname); // clear hash
      if (fanState === 'result') {
        document.getElementById('card3d').classList.remove('flipped');
        document.getElementById('interpretation').classList.remove('visible');
        setTimeout(() => { buildFan(); showFan(); }, 420);
      } else {
        buildFan();
        showFan();
      }
    }

    // 第一顆分享按鈕：固定分享 /cards 不帶結果
    function sharePage() {
      const text = '我正在溪水邊為自己抽張卡 🃏\n溪水邊 Stream Side';
      const url = location.origin + location.pathname;
      if (navigator.share) {
        navigator.share({ title: '溪水邊 · 為自己抽張卡', text, url }).catch(() => copyToClipboard(text, url));
      } else {
        copyToClipboard(text, url);
      }
    }

    // 分享這張卡：帶 hash 的完整連結
    function shareCard() {
      const card = selectedCardIndex >= 0 ? CARDS[selectedCardIndex] : null;
      const text = card
        ? '我從溪水邊抽到了「' + card.title + '」\n' + card.interpretMessage + '\n\n溪水邊 Stream Side · 為自己抽張卡'
        : '我正在溪水邊為自己抽張卡 🃏\n溪水邊 Stream Side';
      const url = window.location.href; // includes hash
      if (navigator.share) {
        navigator.share({ title: '溪水邊 · 為自己抽張卡', text, url }).catch(() => copyToClipboard(text, url));
      } else {
        copyToClipboard(text, url);
      }
    }

    function copyToClipboard(text, url) {
      navigator.clipboard.writeText(text + '\n' + url)
        .then(() => showToast('✓ 已複製到剪貼板'))
        .catch(() => showToast('請手動複製頁面連結分享'));
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2800);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const hash = decodeURIComponent(location.hash.slice(1));
      const cardIndex = hash ? CARDS.findIndex(c => c.interpretTitle === hash) : -1;

      if (cardIndex >= 0) {
        // Direct link to a specific card — skip fan, show result immediately
        document.getElementById('cardFan').style.display = 'none';
        showCardResult(cardIndex, false);
      } else {
        buildFan();
        showFan();
      }
    });
  </script>
---

<script>
const CARDS = {{ cards | dump | safe }};
CARDS.forEach(function(c) { if (c.image) { new Image().src = c.image; } });
</script>

<!-- ══════════════ PAGE INTRO ══════════════ -->
<div style="text-align:center;padding:4rem 1.5rem 1rem;">
  <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw-text);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.cards_label }}</p>
  <h1 style="font-size:clamp(1.8rem,3.5vw,2.5rem);color:var(--oak);margin-bottom:0.75rem;">{{ ui.cards_title }}</h1>
  <p style="color:rgba(67,52,48,0.6);font-size:0.95rem;max-width:420px;margin:0 auto;line-height:1.9;">
    {{ ui.cards_subtitle_1 }}<br>
    {{ ui.cards_subtitle_2 }}
  </p>
</div>

<!-- ══════════════ CARD STAGE ══════════════ -->
<section class="card-stage" aria-labelledby="card-heading">
  <h2 id="card-heading" style="position:absolute;opacity:0;pointer-events:none;">互動抽卡區</h2>

  <!-- Fan of 10 cards (populated by JS) -->
  <div class="card-fan" id="cardFan" aria-label="牌卡組，點擊任一張翻牌"></div>

  <!-- Result card — shown after fan collapses -->
  <div class="card-3d-wrap" id="cardResultWrap">
    <div class="card-3d" id="card3d">

      <!-- Back face -->
      <div class="card-face card-back-face" aria-hidden="true">
        <div class="card-pattern">✦</div>
      </div>

      <!-- Front face -->
      <div class="card-face card-front-face" id="cardFront">
        <div class="card-image-area" id="cardEmoji" aria-hidden="true">✨</div>
        <h3 id="cardTitle"></h3>
        <p id="cardKeyword" style="font-size:0.78rem;color:var(--straw-text);font-weight:600;margin:0.2rem 0 0.4rem;"></p>
      </div>

    </div>
  </div>

  <!-- ── Control Buttons ── -->
  <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-bottom:2.5rem;" role="group" aria-label="抽卡操作">
    <button class="btn-primary" id="redrawBtn" onclick="redraw()" aria-label="重新抽卡" style="font-size:0.85rem;padding:0.6rem 1.5rem;">
      {{ ui.cards_btn_redraw }}
    </button>
    <button class="btn-outline" id="shareBtn" onclick="sharePage()" aria-label="分享牌卡" style="font-size:0.85rem;padding:0.6rem 1.5rem;">
      {{ ui.cards_btn_share }}
    </button>
  </div>

  <!-- ── Interpretation Area ── -->
  <div class="card-interpretation" id="interpretation" role="region" aria-live="polite" aria-label="牌卡解析">
    <div style="width:40px;height:2px;background:var(--straw);margin:0 auto 1.5rem;border-radius:2px;"></div>
    <h2 id="interpretTitle"></h2>
    <p id="interpretBody" style="margin-top:0.75rem;white-space:pre-line;"></p>
    <p class="card-message" id="interpretMessage"></p>
    <div id="cardTags" style="display:flex;gap:0.4rem;flex-wrap:wrap;justify-content:center;margin-top:1rem;min-height:1rem;"></div>
    <div style="margin-top:2rem;display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
      <button onclick="shareCard()" class="btn-outline" style="font-size:0.82rem;padding:0.5rem 1.4rem;">{{ ui.cards_btn_share2 }}</button>
      <a id="articlesBtn" href="{{ '/articles/' | url }}" class="btn-outline" style="font-size:0.82rem;padding:0.5rem 1.4rem;">{{ ui.cards_btn_articles }}</a>
      <a href="{{ '/booking/' | url }}" class="btn-outline" style="font-size:0.82rem;padding:0.5rem 1.4rem;">找人聊聊</a>
    </div>
  </div>

</section>
