---
layout: base.njk
title: 聲音與著作｜溪水邊 Streamspsy
description: 溪水邊 Streamspsy 聲音與著作 — Podcast 節目與出版著作一覽。
activeNav: media
---

<!-- ══════════════ PAGE HERO ══════════════ -->
<div class="page-hero">
  <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.media_hero_label }}</p>
  <h1>{{ ui.media_hero_title }}</h1>
  <p>{{ ui.media_hero_subtitle }}</p>
</div>

<!-- ══════════════ PODCAST SECTION ══════════════ -->
<section class="py-section" aria-labelledby="podcast-heading">
  <div class="content-max">
    <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.media_podcast_label }}</p>
    <h2 class="section-title" id="podcast-heading" style="margin-bottom:0.5rem;">{{ ui.media_podcast_title }}</h2>
    <p style="color:rgba(67,52,48,0.6);font-size:0.9rem;margin-bottom:3rem;">{{ ui.media_podcast_subtitle }}</p>

    {% if podcastAuthors.length %}
    <div style="margin-bottom:2rem;" id="podcast-author-filter">
      <p style="font-size:0.8rem;color:rgba(67,52,48,0.5);margin-bottom:0.75rem;letter-spacing:0.05em;">依作者瀏覽：</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;">
        <button class="tag-btn podcast-author-btn active" data-author="all">全部</button>
        {% for name in podcastAuthors %}
          <button class="tag-btn podcast-author-btn" data-author="{{ name }}">{{ name }}</button>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if podcast.episodes.length %}

      <!-- ── 最新集數 NEW ── -->
      <div style="margin-bottom:3rem;">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;">
          <h3 style="font-size:0.9rem;color:var(--oak);font-weight:700;letter-spacing:0.08em;">最新集數</h3>
          <span style="background:#2d9e6b;color:white;font-size:0.68rem;font-weight:700;letter-spacing:0.1em;padding:0.2rem 0.55rem;border-radius:2rem;">NEW</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:0;">
          {% for ep in podcast.episodes %}{% if loop.index <= 3 %}
            <article class="podcast-item" data-authors="{{ ep.authors | join('|||') }}">
              <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.25rem;">
                {% if ep.image %}
                  <img src="{{ ep.image }}" alt="{{ ep.title }}" style="width:56px;height:56px;border-radius:0.5rem;object-fit:cover;flex-shrink:0;">
                {% else %}
                  <div style="background:var(--sprout);width:56px;height:56px;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">🎙️</div>
                {% endif %}
                <div>
                  <h4 style="font-size:1rem;color:var(--oak);line-height:1.5;margin-bottom:0.25rem;">{{ ep.title }}</h4>
                  <p style="font-size:0.75rem;color:rgba(67,52,48,0.45);">{{ ep.date | dateDisplay }}{% if ep.duration %} · {{ ep.duration }}{% endif %}</p>
                </div>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:1.25rem;align-items:flex-start;">
                {% if ep.embedUrl %}
                  <div style="flex:1;min-width:260px;border-radius:0.75rem;overflow:hidden;">
                    <iframe src="{{ ep.embedUrl }}" width="100%" style="aspect-ratio:1;max-height:480px;display:block;" frameborder="0" scrolling="no" loading="lazy"></iframe>
                  </div>
                {% endif %}
                {% if ep.summary %}
                  <div style="flex:1;min-width:260px;background:var(--rice);border-radius:0.75rem;padding:1.25rem;">
                    <p style="font-size:0.85rem;color:rgba(67,52,48,0.72);line-height:1.9;">{{ ep.summary | striptags | truncate(300) }}</p>
                    <a href="{{ ep.embedUrl or ep.link }}" target="_blank" rel="noopener" style="display:inline-block;margin-top:1rem;font-size:0.78rem;color:var(--straw);font-weight:600;">{{ ui.media_podcast_listen }}</a>
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}{% endfor %}
        </div>
      </div>

      <!-- ── 精選推薦 HOT ── -->
      {% set featuredList = podcast.featured %}
      {% if featuredList.length %}
        <div style="margin-bottom:3rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;">
            <h3 style="font-size:0.9rem;color:var(--oak);font-weight:700;letter-spacing:0.08em;">精選推薦</h3>
            <span style="background:#c0392b;color:white;font-size:0.68rem;font-weight:700;letter-spacing:0.1em;padding:0.2rem 0.55rem;border-radius:2rem;">HOT</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:0;">
            {% for ep in featuredList %}{% if loop.index <= 3 %}
              <article class="podcast-item" data-authors="{{ ep.authors | join('|||') }}">
                <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.25rem;">
                  {% if ep.image %}
                    <img src="{{ ep.image }}" alt="{{ ep.title }}" style="width:56px;height:56px;border-radius:0.5rem;object-fit:cover;flex-shrink:0;">
                  {% else %}
                    <div style="background:var(--sprout);width:56px;height:56px;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">🎙️</div>
                  {% endif %}
                  <div>
                    <h4 style="font-size:1rem;color:var(--oak);line-height:1.5;margin-bottom:0.25rem;">{{ ep.title }}</h4>
                    <p style="font-size:0.75rem;color:rgba(67,52,48,0.45);">{{ ep.date | dateDisplay }}{% if ep.duration %} · {{ ep.duration }}{% endif %}</p>
                  </div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:1.25rem;align-items:flex-start;">
                  {% if ep.embedUrl %}
                    <div style="flex:1;min-width:260px;border-radius:0.75rem;overflow:hidden;">
                      <iframe src="{{ ep.embedUrl }}" width="100%" style="aspect-ratio:1;max-height:480px;display:block;" frameborder="0" scrolling="no" loading="lazy"></iframe>
                    </div>
                  {% endif %}
                  {% if ep.summary %}
                    <div style="flex:1;min-width:260px;background:var(--rice);border-radius:0.75rem;padding:1.25rem;">
                      <p style="font-size:0.85rem;color:rgba(67,52,48,0.72);line-height:1.9;">{{ ep.summary | striptags | truncate(300) }}</p>
                      <a href="{{ ep.embedUrl or ep.link }}" target="_blank" rel="noopener" style="display:inline-block;margin-top:1rem;font-size:0.78rem;color:var(--straw);font-weight:600;">{{ ui.media_podcast_listen }}</a>
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endif %}{% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- ── 全部集數 ── -->
      <div>
        <h3 style="font-size:0.9rem;color:var(--oak);font-weight:700;letter-spacing:0.08em;margin-bottom:1.5rem;">全部集數</h3>
        <div id="podcast-list" style="display:flex;flex-direction:column;gap:0;">
          {% for ep in podcast.episodes %}
            <article class="podcast-item" data-authors="{{ ep.authors | join('|||') }}" {% if loop.index > 4 %}data-hidden="true" style="display:none;"{% endif %}>
              <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.25rem;">
                {% if ep.image %}
                  <img src="{{ ep.image }}" alt="{{ ep.title }}" style="width:56px;height:56px;border-radius:0.5rem;object-fit:cover;flex-shrink:0;">
                {% else %}
                  <div style="background:var(--sprout);width:56px;height:56px;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">🎙️</div>
                {% endif %}
                <div style="flex:1;">
                  <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                    <h4 style="font-size:1rem;color:var(--oak);line-height:1.5;">{{ ep.title }}</h4>
                    {% if loop.index <= 3 %}<span style="background:#2d9e6b;color:white;font-size:0.65rem;font-weight:700;letter-spacing:0.08em;padding:0.15rem 0.45rem;border-radius:2rem;flex-shrink:0;">NEW</span>{% endif %}
                    {% if ep.featured %}<span style="background:#c0392b;color:white;font-size:0.65rem;font-weight:700;letter-spacing:0.08em;padding:0.15rem 0.45rem;border-radius:2rem;flex-shrink:0;">HOT</span>{% endif %}
                  </div>
                  <p style="font-size:0.75rem;color:rgba(67,52,48,0.45);">{{ ep.date | dateDisplay }}{% if ep.duration %} · {{ ep.duration }}{% endif %}</p>
                </div>
              </div>
              {% if ep.summary %}
                <p style="font-size:0.82rem;color:rgba(67,52,48,0.6);line-height:1.8;margin-bottom:0.75rem;">{{ ep.summary | striptags | truncate(120) }}</p>
              {% endif %}
              <a href="{{ ep.embedUrl or ep.link }}" target="_blank" rel="noopener" style="font-size:0.78rem;color:var(--straw);font-weight:600;">{{ ui.media_podcast_listen_short }}</a>
            </article>
          {% endfor %}
        </div>

        {% if podcast.episodes.length > 4 %}
          <div style="text-align:center;margin-top:2.5rem;">
            <button id="podcast-load-more" class="btn-outline" onclick="loadMoreEpisodes()">{{ ui.media_podcast_load_more }}</button>
            <p id="podcast-count" style="font-size:0.78rem;color:rgba(67,52,48,0.4);margin-top:0.75rem;">顯示 4 / {{ podcast.episodes.length }} 集</p>
          </div>
        {% endif %}

        <script>
          var podcastShown = 4;
          var podcastTotal = {{ podcast.episodes.length }};
          var podcastStep = 4;
          var currentAuthorFilter = 'all';

          function getPodcastListItems() {
            return document.querySelectorAll('#podcast-list .podcast-item');
          }

          function matchesAuthor(item, author) {
            if (author === 'all') return true;
            return (item.dataset.authors || '').split('|||').includes(author);
          }

          function updateLoadMore() {
            var items = getPodcastListItems();
            var matched = Array.from(items).filter(function(i) { return matchesAuthor(i, currentAuthorFilter); });
            var shown = matched.filter(function(i) { return i.style.display !== 'none'; }).length;
            var total = matched.length;
            var countEl = document.getElementById('podcast-count');
            var btnEl = document.getElementById('podcast-load-more');
            if (!countEl || !btnEl) return;
            if (shown >= total) {
              btnEl.style.display = 'none';
              countEl.textContent = '已顯示全部 ' + total + ' 集';
            } else {
              btnEl.style.display = '';
              countEl.textContent = '顯示 ' + shown + ' / ' + total + ' 集';
            }
          }

          function applyPodcastAuthorFilter(author) {
            currentAuthorFilter = author;
            var items = getPodcastListItems();
            var shown = 0;
            items.forEach(function(item) {
              var matches = matchesAuthor(item, author);
              if (matches && (shown < podcastStep || author !== 'all')) {
                item.style.display = '';
                shown++;
              } else if (matches && shown >= podcastStep) {
                item.style.display = 'none';
              } else {
                item.style.display = 'none';
              }
            });
            // When filtering, show all matched items at once
            if (author !== 'all') {
              items.forEach(function(item) {
                if (matchesAuthor(item, author)) item.style.display = '';
              });
            } else {
              // Restore default: show first podcastStep
              podcastShown = 0;
              items.forEach(function(item) {
                if (podcastShown < podcastStep) {
                  item.style.display = '';
                  podcastShown++;
                } else {
                  item.style.display = 'none';
                }
              });
            }
            updateLoadMore();

            // Also filter 最新/精選 sections
            document.querySelectorAll('.podcast-item[data-authors]').forEach(function(item) {
              if (!item.closest('#podcast-list')) {
                item.style.display = matchesAuthor(item, author) ? '' : 'none';
              }
            });
          }

          function loadMoreEpisodes() {
            var items = getPodcastListItems();
            var revealed = 0;
            items.forEach(function(item) {
              if (matchesAuthor(item, currentAuthorFilter) && item.style.display === 'none' && revealed < podcastStep) {
                item.style.display = '';
                revealed++;
                podcastShown++;
              }
            });
            updateLoadMore();
          }

          // Author filter buttons
          document.querySelectorAll('.podcast-author-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              document.querySelectorAll('.podcast-author-btn').forEach(function(b) { b.classList.remove('active'); });
              btn.classList.add('active');
              var author = btn.dataset.author;
              if (author === 'all') {
                location.hash = '';
              } else {
                location.hash = 'author=' + encodeURIComponent(author);
              }
            });
          });

          // Hash-based init
          function initPodcastFromHash() {
            var h = decodeURIComponent(location.hash.slice(1));
            var author = 'all';
            if (h.startsWith('author=')) author = h.slice(7);
            document.querySelectorAll('.podcast-author-btn').forEach(function(b) {
              b.classList.toggle('active', b.dataset.author === author);
            });
            applyPodcastAuthorFilter(author);
          }

          window.addEventListener('hashchange', initPodcastFromHash);
          initPodcastFromHash();
        </script>
      </div>

    {% else %}
      <!-- Placeholder -->
      <article class="podcast-item">
        <div style="display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.25rem;">
          <div style="background:var(--sprout);width:56px;height:56px;border-radius:0.5rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;">🎙️</div>
          <div>
            <h4 style="font-size:1rem;color:var(--oak);line-height:1.5;margin-bottom:0.25rem;"><span class="placeholder-text">Podcast 集數標題 Placeholder</span></h4>
            <p style="font-size:0.75rem;color:rgba(67,52,48,0.45);">2026年 · 約30分鐘</p>
          </div>
        </div>
        <div class="podcast-player-placeholder" aria-label="音頻播放器佔位符"><span>🎵</span><span>Podcast 播放器 Placeholder</span></div>
      </article>
    {% endif %}

  </div>
</section>

<div class="divider" style="margin:0 1.5rem;"></div>

<!-- ══════════════ BOOKS SECTION ══════════════ -->
<section class="py-section" aria-labelledby="books-heading">
  <div class="content-max">
    <p style="font-size:0.8rem;letter-spacing:0.18em;color:var(--straw);margin-bottom:0.5rem;text-transform:uppercase;">{{ ui.media_books_label }}</p>
    <h2 class="section-title" id="books-heading" style="margin-bottom:0.5rem;">{{ ui.media_books_title }}</h2>
    <p style="color:rgba(67,52,48,0.6);font-size:0.9rem;margin-bottom:3rem;">{{ ui.media_books_subtitle }}</p>

    <div class="book-grid">

      {% set bookColors = ['', 'background:linear-gradient(160deg,var(--sprout) 0%,var(--oak) 100%);', 'background:linear-gradient(160deg,#c9b7a8 0%,var(--bark) 100%);', 'background:linear-gradient(160deg,var(--straw) 0%,#a0785a 100%);'] %}
      {% for i in [1,2,3,4] %}
        {% set t = 'book' + i + '_title' %}
        {% set d = 'book' + i + '_desc' %}
        {% set l = 'book' + i + '_link' %}
        {% if ui[t] %}
        <article class="book-item">
          <a href="{{ ui[l] or '#' }}" target="_blank" rel="noopener" aria-label="{{ ui[t] }}">
            <div class="book-cover" style="{{ bookColors[i - 1] }}">
              <span style="text-align:center;padding:0.5rem;font-size:0.68rem;">書封</span>
            </div>
          </a>
          <h3 class="book-title">{{ ui[t] }}</h3>
          {% if ui[d] %}<p class="book-desc">{{ ui[d] }}</p>{% endif %}
          {% if ui[l] %}<a href="{{ ui[l] }}" target="_blank" rel="noopener" style="display:inline-block;margin-top:0.5rem;font-size:0.75rem;color:var(--straw);font-weight:600;">購買 →</a>{% endif %}
        </article>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>
