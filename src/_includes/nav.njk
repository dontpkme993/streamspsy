<!-- ══════════════ NAV ══════════════ -->
<header class="site-header" role="banner">
  <div class="nav-inner">
    <a href="{{ '/index2/' | url }}" class="nav-logo" aria-label="{{ ui.site_name }}首頁">
      {{ ui.site_name }} <span>{{ ui.site_tagline }}</span>
    </a>
    <nav aria-label="主選單">
      <ul class="nav-links" role="list">
        <li><a href="{{ '/about/' | url }}"{% if activeNav == 'about' %} class="active"{% endif %}>{{ ui.nav_about }}</a></li>
        <li><a href="{{ '/booking/' | url }}"{% if activeNav == 'booking' %} class="active"{% endif %}>{{ ui.nav_booking }}</a></li>
        <li><a href="{{ '/articles/' | url }}"{% if activeNav == 'articles' %} class="active"{% endif %}>{{ ui.nav_articles }}</a></li>
        <li><a href="{{ '/media/' | url }}"{% if activeNav == 'media' %} class="active"{% endif %}>{{ ui.nav_media }}</a></li>
        <li><a href="{{ '/events/' | url }}"{% if activeNav == 'events' %} class="active"{% endif %}>{{ ui.nav_events }}</a></li>
        <li><a href="{{ '/cards/' | url }}"{% if activeNav == 'cards' %} class="active"{% endif %}>{{ ui.nav_cards }}</a></li>
      </ul>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="手機選單">
    <a href="{{ '/about/' | url }}">{{ ui.nav_mobile_about }}</a>
    <a href="{{ '/booking/' | url }}">{{ ui.nav_mobile_booking }}</a>
    <a href="{{ '/articles/' | url }}">{{ ui.nav_mobile_articles }}</a>
    <a href="{{ '/media/' | url }}">{{ ui.nav_mobile_media }}</a>
    <a href="{{ '/events/' | url }}">{{ ui.nav_mobile_events }}</a>
    <a href="{{ '/cards/' | url }}">{{ ui.nav_mobile_cards }}</a>
  </nav>
</header>
