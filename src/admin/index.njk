      <p style="font-size:0.78rem;color:rgba(67,52,48,0.55);margin-bottom:1.5rem;">請使用 SoundOn 單集頁面網址，格式為：<code style="font-size:0.75rem;background:rgba(67,52,48,0.07);padding:0.1rem 0.35rem;border-radius:4px;">https://player.soundon.fm/p/…/episodes/…</code></p>
      <div class="group-fields">
        <div class="field-item field-full">
          <label for="ep-url">單集連結 *</label>
          <input type="url" id="ep-url" placeholder="https://player.soundon.fm/p/…/episodes/…" />
        </div>
      </div>
      <div style="margin-top:1.5rem;">
        <button class="btn-save" id="btn-add-ep">新增到 Notion</button>
      </div>
      <div class="status-box" id="podcast-status"></div>
    </div>

  </div>

  <script>
    // ── Podcast 設定 ──────────────────────────────────────────
    const PODCAST_WORKFLOW = 'add-podcast-manual.yml';
    const PODCAST_REPO     = 'dontpkme993/streamspsy';
    const PODCAST_API_BASE = 'https://api.github.com';

    function setPodcastStatus(id, type, msg) {
      const el = document.getElementById(id);
      el.className = 'status-box show ' + type;
      el.textContent = msg;
    }

    // ── RSS 設定 ──────────────────────────────────────────────
    async function loadRssUrl() {
      const token = document.getElementById('gh-token').value.trim();
      if (!token) return;
      try {
        const res = await fetch(
          `${PODCAST_API_BASE}/repos/${PODCAST_REPO}/actions/variables/PODCAST_RSS_URL`,
          { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28' } }
        );
        if (res.ok) {
          const data = await res.json();
          document.getElementById('rss-url').value = data.value || '';
        }
      } catch (e) { /* 靜默失敗，不阻斷頁面 */ }
    }

    document.querySelector('[data-tab="tab-podcast"]').addEventListener('click', loadRssUrl);

    document.getElementById('btn-save-rss').addEventListener('click', async function () {
      const token = document.getElementById('gh-token').value.trim();
      if (!token) { setPodcastStatus('rss-status', 'error', '請先載入 GitHub Token'); return; }
      const value = document.getElementById('rss-url').value.trim();
      if (value && !/^https?:\/\/.+/.test(value)) {
        setPodcastStatus('rss-status', 'error', '網址格式不正確，請輸入 http:// 或 https:// 開頭的網址');
        return;
      }

      this.disabled = true;
      setPodcastStatus('rss-status', 'loading', '儲存中…');
      try {
        const varUrl = `${PODCAST_API_BASE}/repos/${PODCAST_REPO}/actions/variables/PODCAST_RSS_URL`;
        const headers = {
          'Authorization': `Bearer ${token}`,
          'Accept': 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
        };
        // GitHub API 不允許空字串 value，清空時改用 DELETE 刪除變數
        const res = value
          ? await fetch(varUrl, {
              method: 'PATCH',
              headers: { ...headers, 'Content-Type': 'application/json' },
              body: JSON.stringify({ name: 'PODCAST_RSS_URL', value }),
            })
          : await fetch(varUrl, { method: 'DELETE', headers });
        if (res.status === 204 || res.status === 200) {
          setPodcastStatus('rss-status', 'success', value ? '✓ RSS 網址已更新' : '✓ RSS 網址已清空，下次同步將略過');
        } else if (res.status === 403) {
          throw new Error('Token 權限不足，需要 Variables: Read and write 權限');
        } else {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch (e) {
        setPodcastStatus('rss-status', 'error', '失敗：' + e.message);
      } finally {
        this.disabled = false;
      }
    });

    document.getElementById('btn-add-ep').addEventListener('click', async function () {
      const token  = document.getElementById('gh-token').value.trim();
      if (!token) { setPodcastStatus('podcast-status', 'error', '請先在上方載入 GitHub Token'); return; }

      const url = document.getElementById('ep-url').value.trim();
      if (!url) { setPodcastStatus('podcast-status', 'error', '請輸入單集連結'); return; }
      const validSoundOn = /^https:\/\/player\.soundon\.fm\/p\/[a-f0-9-]{36}\/episodes\/[a-f0-9-]{36}/i;
      if (!validSoundOn.test(url)) {
        setPodcastStatus('podcast-status', 'error', '網址格式不正確，請使用 SoundOn 單集頁面網址（https://player.soundon.fm/p/…/episodes/…）');
        return;
      }

      this.disabled = true;
      setPodcastStatus('podcast-status', 'loading', '提交中，請稍候…');

      try {
        const res = await fetch(
          `${PODCAST_API_BASE}/repos/${PODCAST_REPO}/actions/workflows/${PODCAST_WORKFLOW}/dispatches`,
          {
            method: 'POST',
            headers: {
              'Authorization':        `Bearer ${token}`,
              'Accept':               'application/vnd.github+json',
              'X-GitHub-Api-Version': '2022-11-28',
              'Content-Type':         'application/json',
            },
            body: JSON.stringify({ ref: 'main', inputs: { url } }),
          }
        );

        if (res.status === 204) {
          setPodcastStatus('podcast-status', 'success', '✓ 已提交！約 30 秒後從 RSS 比對並新增至 Notion。');
          document.getElementById('ep-url').value = '';
        } else if (res.status === 401) {
          throw new Error('Token 無效或已過期');
        } else if (res.status === 403) {
          throw new Error('Token 權限不足，需要 Actions: Write 權限');
        } else if (res.status === 422) {
          throw new Error('Workflow 不存在，請確認已推送至 main');
        } else {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch (e) {
        setPodcastStatus('podcast-status', 'error', '失敗：' + e.message);
      } finally {
        this.disabled = false;
      }
    });
  </script>

  <!-- Tab 4: 圖片管理 -->
  <div class="tab-panel" id="tab-images">

    <div style="display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;align-items:center;">
      <button class="btn-save" id="btn-load-images">載入目前圖片設定</button>
    </div>
    <div class="status-box" id="images-load-status"></div>

    <div class="img-cards" id="img-cards" style="display:none;"></div>

    <div class="save-bar" id="images-save-bar" style="display:none;margin-top:1.5rem;">
      <span class="save-info" id="images-save-info">已是最新版本</span>
      <button class="btn-save" id="btn-save-images">儲存並重新發布</button>
    </div>
    <div class="status-box" id="images-save-status"></div>

  </div>

  <script>
  // ── 圖片管理 Tab ─────────────────────────────────────────
  (function () {
    const REPO      = 'dontpkme993/streamspsy';
    const FILE_PATH = 'src/_data/siteImages.json';
    const API_BASE  = 'https://api.github.com';

    const LABELS = {
      HOME_BANNER: { label: '首頁 Banner', desc: 'index2.njk 主視覺橫幅' },
      FOUNDER_PORTRAIT: { label: '創辦人形象照', desc: 'about.njk 個人簡介區塊', square: true },
    };

    let currentSha   = null;
    let currentData  = {};
    let pendingFiles = {}; // key → { file, dataUrl, ext }

    function getToken() { return document.getElementById('gh-token').value.trim(); }

    function setStatus(id, type, msg) {
      const el = document.getElementById(id);
      el.className = 'status-box show ' + type;
      el.textContent = msg;
    }

    function toB64(str) { return btoa(unescape(encodeURIComponent(str))); }
    function fromB64(b64) { return decodeURIComponent(escape(atob(b64.replace(/\n/g, '')))); }

    async function loadImages() {
      const token = getToken();
      if (!token) { setStatus('images-load-status', 'error', '請先在上方輸入 GitHub Token'); return; }

      document.getElementById('btn-load-images').disabled = true;
      setStatus('images-load-status', 'loading', '載入中…');

      try {
        const res = await fetch(
          `${API_BASE}/repos/${REPO}/contents/${FILE_PATH}`,
          { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' } }
        );
        if (res.status === 401) throw new Error('Token 無效或已過期');
        if (res.status === 403) throw new Error('Token 權限不足');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json   = await res.json();
        currentSha   = json.sha;
        currentData  = JSON.parse(fromB64(json.content));

        renderCards();
        document.getElementById('img-cards').style.display = 'flex';
        document.getElementById('images-save-bar').style.display = 'flex';
        setStatus('images-load-status', 'success', '✓ 載入成功，可直接修改圖片網址');
      } catch (e) {
        setStatus('images-load-status', 'error', '載入失敗：' + e.message);
      } finally {
        document.getElementById('btn-load-images').disabled = false;
      }
    }

    function renderCards() {
      const container = document.getElementById('img-cards');
      const entries   = Object.entries(currentData);

      container.innerHTML = entries.map(([key, url], i) => {
        const meta = LABELS[key] || { label: key, desc: '' };
        const pw   = '160px';
        const ph   = meta.square ? '160px' : '90px';
        const pPos = meta.square ? 'top' : 'center';
        return `
          <div class="img-card">
            <div class="img-card-header">
              <div class="img-card-name">${key}</div>
              ${meta.desc ? `<div class="img-card-desc">${meta.label}　<span style="opacity:0.5">${meta.desc}</span></div>` : `<div class="img-card-desc">${meta.label}</div>`}
            </div>
            <div class="img-card-body">
              <div>
                ${url
                  ? `<img class="img-preview" id="img-preview-${i}" src="${url}" alt="${key}"
                       style="width:${pw};height:${ph};object-position:${pPos}"
                       onerror="this.style.display='none';document.getElementById('img-empty-${i}').style.display='flex'">`
                  : ''}
                <div class="img-preview-empty" id="img-empty-${i}" style="display:${url ? 'none' : 'flex'};width:${pw};height:${ph}">尚無圖片</div>
              </div>
              <div class="img-url-section">
                <label for="img-url-${i}">圖片網址</label>
                <input type="url" class="img-url-input" id="img-url-${i}"
                  value="${url}" placeholder="https://… 或選擇圖片自動填入"
                  data-key="${key}" data-original="${url}" data-index="${i}" />
                <label class="img-upload-btn" for="img-file-${i}">選擇圖片檔案</label>
                <input type="file" class="img-upload-input" id="img-file-${i}"
                  accept="image/*" data-key="${key}" data-index="${i}" />
                <div class="img-upload-hint" id="img-upload-hint-${i}"></div>
              </div>
            </div>
          </div>`;
      }).join('');

      container.querySelectorAll('.img-url-input').forEach(input => {
        input.addEventListener('input', () => {
          input.classList.toggle('changed', input.value !== input.dataset.original);
          updatePreview(input.dataset.index, input.value);
        });
      });

      container.querySelectorAll('.img-upload-input').forEach(fileInput => {
        fileInput.addEventListener('change', () => {
          const file = fileInput.files[0];
          if (!file) return;
          const key  = fileInput.dataset.key;
          const i    = fileInput.dataset.index;
          const ext  = file.name.split('.').pop().toLowerCase();
          const hint = document.getElementById('img-upload-hint-' + i);

          const reader = new FileReader();
          reader.onload = e => {
            const dataUrl = e.target.result;
            pendingFiles[key] = { file, dataUrl: dataUrl.split(',')[1], ext };
            updatePreview(i, dataUrl);

            // 預填 URL 欄位（上傳後才是真實路徑，先標示待上傳）
            const urlInput = document.getElementById('img-url-' + i);
            urlInput.value = `/assets/images/site-${key.toLowerCase()}.${ext}`;
            urlInput.classList.add('changed');
            hint.textContent = `已選取：${file.name}（${(file.size / 1024).toFixed(0)} KB）`;
          };
          reader.readAsDataURL(file);
        });
      });
    }

    function updatePreview(i, src) {
      const entries = Object.entries(currentData);
      const key     = entries[i]?.[0] || '';
      const meta    = LABELS[key] || {};
      const ph      = meta.square ? '160px' : '90px';

      const preview = document.getElementById('img-preview-' + i);
      const empty   = document.getElementById('img-empty-'   + i);
      if (src) {
        if (preview) { preview.src = src; preview.style.display = ''; }
        else {
          const img     = document.createElement('img');
          img.className = 'img-preview';
          img.id        = 'img-preview-' + i;
          img.src       = src;
          img.style.cssText = `width:160px;height:${ph};object-position:${meta.square ? 'top' : 'center'}`;
          img.onerror   = () => { img.style.display = 'none'; if (empty) empty.style.display = 'flex'; };
          empty.parentNode.insertBefore(img, empty);
        }
        if (empty) empty.style.display = 'none';
      } else {
        if (preview) preview.style.display = 'none';
        if (empty)   empty.style.display   = 'flex';
      }
    }

    async function uploadImageFile(token, key, dataUrl, ext) {
      const path = `src/assets/images/site-${key.toLowerCase()}.${ext}`;
      // 先取現有 sha（若已存在）
      let existingSha;
      try {
        const check = await fetch(
          `${API_BASE}/repos/${REPO}/contents/${path}`,
          { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' } }
        );
        if (check.ok) { const j = await check.json(); existingSha = j.sha; }
      } catch (_) {}

      const res = await fetch(
        `${API_BASE}/repos/${REPO}/contents/${path}`,
        {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Accept':        'application/vnd.github+json',
            'Content-Type':  'application/json',
          },
          body: JSON.stringify({
            message: `Upload site image: ${key}`,
            content: dataUrl,
            ...(existingSha ? { sha: existingSha } : {}),
          })
        }
      );
      if (!res.ok) throw new Error(`圖片上傳失敗（${key}）HTTP ${res.status}`);
      return `/assets/images/site-${key.toLowerCase()}.${ext}`;
    }

    async function saveImages() {
      const token = getToken();
      if (!token)     { setStatus('images-save-status', 'error', '請先輸入 GitHub Token'); return; }
      if (!currentSha){ setStatus('images-save-status', 'error', '請先按「載入目前圖片設定」'); return; }

      document.getElementById('btn-save-images').disabled = true;
      setStatus('images-save-status', 'loading', '儲存中，請稍候…');

      try {
        // 1. 先上傳有待傳圖片的 key
        for (const [key, { dataUrl, ext }] of Object.entries(pendingFiles)) {
          setStatus('images-save-status', 'loading', `上傳圖片 ${key}…`);
          await uploadImageFile(token, key, dataUrl, ext);
        }
        pendingFiles = {};

        // 2. 收集所有 URL 更新 siteImages.json
        const newData = { ...currentData };
        document.querySelectorAll('.img-url-input').forEach(input => {
          newData[input.dataset.key] = input.value;
        });

        setStatus('images-save-status', 'loading', '更新圖片設定…');
        const res = await fetch(
          `${API_BASE}/repos/${REPO}/contents/${FILE_PATH}`,
          {
            method: 'PUT',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept':        'application/vnd.github+json',
              'Content-Type':  'application/json',
            },
            body: JSON.stringify({
              message: 'Update site images via admin panel',
              content: toB64(JSON.stringify(newData, null, '\t')),
              sha:     currentSha,
            })
          }
        );

        if (res.status === 401) throw new Error('Token 無效或已過期');
        if (res.status === 403) throw new Error('Token 權限不足');
        if (res.status === 409) throw new Error('檔案已被修改，請重新載入後再存');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const result = await res.json();
        currentSha   = result.content.sha;
        currentData  = newData;

        document.querySelectorAll('.img-url-input').forEach(input => {
          input.dataset.original = input.value;
          input.classList.remove('changed');
        });
        document.querySelectorAll('.img-upload-hint').forEach(el => el.textContent = '');

        setStatus('images-save-status', 'success', '✓ 儲存成功！GitHub Actions 正在重新 build，約 1 分鐘後上線。');
      } catch (e) {
        setStatus('images-save-status', 'error', '儲存失敗：' + e.message);
      } finally {
        document.getElementById('btn-save-images').disabled = false;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-load-images').addEventListener('click', loadImages);
      document.getElementById('btn-save-images').addEventListener('click', saveImages);

      // 切換到此 tab 時自動載入（若 GitHub Token 已輸入）
      document.querySelector('[data-tab="tab-images"]').addEventListener('click', () => {
        if (getToken() && !currentSha) loadImages();
      });
    });
  })();
  </script>

  </div>{# end tabs-wrapper #}
</div>
