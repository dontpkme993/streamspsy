<div class="admin-wrap">

  <div class="admin-header">
    <h1>網站內容管理</h1>
    <p>載入網站資料後開始編輯更新</p>
  </div>

  <!-- Token -->
  <div class="token-card">
    <h2>GitHub Token</h2>
    <div class="token-row">
      <input type="password" id="gh-token" class="token-input" placeholder="github_pat_…" autocomplete="off" />
      <button class="btn-load" id="btn-load">載入目前設定</button>
    </div>
    <p class="token-hint">需要 Fine-grained token，權限：<strong>Contents → Read and write</strong>。Token 僅存於瀏覽器，不會上傳。</p>
    <div class="token-actions">
      <button class="btn-sm" id="btn-save-token">儲存 Token</button>
      <button class="btn-sm" id="btn-clear-token">清除 Token</button>
    </div>
    <div class="status-box" id="load-status"></div>
  </div>

  <!-- Tabs (hidden until load succeeds) -->
  <div id="tabs-wrapper" style="display:none;">
  <div class="tab-bar">
    <button class="tab-btn active" data-tab="tab-text">文字設定</button>
    <button class="tab-btn" data-tab="tab-seo">SEO 設定</button>
    <button class="tab-btn" data-tab="tab-podcast">Podcast 設定</button>
    <button class="tab-btn" data-tab="tab-images">圖片管理</button>
  </div>

  <!-- Tab 1: 文字設定 -->
  <div class="tab-panel active" id="tab-text">
    <div class="field-groups" id="field-groups">
      <div class="empty-state">按「載入目前設定」後即可編輯欄位</div>
    </div>
    <div class="save-bar">
      <span class="save-info" id="save-info">尚未載入</span>
      <button class="btn-save" id="btn-save">儲存並更新網站</button>
    </div>
    <div class="status-box" id="save-status"></div>
  </div>

  <!-- Tab 2: SEO 設定 -->
  <div class="tab-panel" id="tab-seo">
    <div style="display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;align-items:center;">
      <button class="btn-save" id="btn-seo-save" disabled>儲存 SEO 設定</button>
    </div>
    <div class="status-box" id="seo-status"></div>

    {% set seoPages = [
      { label: '首頁',       path: 'src/index.njk' },
