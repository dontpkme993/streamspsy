  .seo-page-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--bark);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(140,106,93,0.1);
  }
