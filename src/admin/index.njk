---
layout: base.njk
title: 網站內容管理｜溪水邊
description: 溪水邊內部管理頁面
permalink: /admin/
eleventyExcludeFromCollections: true
pageStyle: |
  .admin-wrap {
    max-width: 780px;
    margin: 3rem auto;
    padding: 0 1.5rem 6rem;
  }
  .admin-header {
    margin-bottom: 2rem;
  }
  .admin-header h1 {
    font-size: 1.5rem;
    color: var(--bark);
    margin-bottom: 0.3rem;
  }
  .admin-header p {
    font-size: 0.875rem;
    color: var(--oak);
    opacity: 0.75;
  }

  /* Token card */
  .token-card {
    background: #fff;
    border: 1px solid rgba(140,106,93,0.15);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 10px rgba(67,52,48,0.05);
  }
  .token-card h2 {
    font-size: 0.92rem;
    color: var(--oak);
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .token-row {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
    flex-wrap: wrap;
  }
  .token-input {
    flex: 1;
    min-width: 200px;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(140,106,93,0.3);
    border-radius: 8px;
    font-size: 0.875rem;
    background: var(--rice);
    color: var(--bark);
    font-family: monospace;
    transition: border-color 0.2s;
  }
  .token-input:focus { outline: none; border-color: var(--oak); }
  .token-hint {
    font-size: 0.78rem;
    color: var(--oak);
    opacity: 0.6;
    margin-top: 0.5rem;
  }
  .token-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn-sm {
    font-size: 0.78rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(140,106,93,0.3);
    border-radius: 6px;
    background: transparent;
    color: var(--oak);
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-sm:hover { background: var(--sprout); }
  .btn-load {
    font-size: 0.875rem;
    padding: 0.55rem 1.25rem;
    border: none;
    border-radius: 8px;
    background: var(--oak);
    color: #fff;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .btn-load:hover { background: var(--bark); }
  .btn-load:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Section groups */
  .field-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .field-group {
    background: #fff;
    border: 1px solid rgba(140,106,93,0.15);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(67,52,48,0.05);
  }
  .group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    gap: 1rem;
  }
  .group-summary::-webkit-details-marker { display: none; }
  .group-summary:hover { background: rgba(233,237,201,0.3); }
  .group-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--bark);
  }
  .group-meta {
    font-size: 0.75rem;
    color: rgba(67,52,48,0.45);
  }
  .group-chevron {
    font-size: 0.7rem;
    color: var(--oak);
    transition: transform 0.2s;
  }
  details[open] .group-chevron { transform: rotate(180deg); }
  .group-fields {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid rgba(140,106,93,0.1);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.5rem;
  }
  @media (max-width: 600px) {
    .group-fields { grid-template-columns: 1fr; }
  }
  .field-full { grid-column: 1 / -1; }

  /* Individual field */
  .field-item label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--oak);
    margin-bottom: 0.3rem;
    opacity: 0.85;
  }
  .field-item input,
  .field-item textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(140,106,93,0.25);
    border-radius: 7px;
    font-size: 0.875rem;
    background: var(--rice);
    color: var(--bark);
    font-family: inherit;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }
  .field-item input:focus,
  .field-item textarea:focus {
    outline: none;
    border-color: var(--oak);
    background: #fff;
  }
  .field-item textarea {
    resize: vertical;
    min-height: 70px;
    line-height: 1.6;
  }
  .field-item input.changed,
  .field-item textarea.changed {
    border-color: #c8a96e;
    background: #fffdf5;
  }

  /* Save bar */
  .save-bar {
    position: sticky;
    bottom: 1.5rem;
    margin-top: 1.5rem;
    background: #fff;
    border: 1px solid rgba(140,106,93,0.2);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    box-shadow: 0 4px 20px rgba(67,52,48,0.12);
    flex-wrap: wrap;
  }
  .save-info {
    font-size: 0.85rem;
    color: rgba(67,52,48,0.55);
  }
  .save-info.dirty { color: #a07030; font-weight: 600; }
  .btn-save {
    padding: 0.65rem 1.75rem;
    border: none;
    border-radius: 8px;
    background: var(--straw);
    color: var(--bark);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 0.03em;
  }
  .btn-save:hover { background: #c49060; }
  .btn-save:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Status */
  .status-box {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    display: none;
    margin-top: 0.75rem;
  }
  .status-box.show { display: block; }
  .status-box.success { background: #edf7ee; color: #2d6a31; border: 1px solid #b7dfb9; }
  .status-box.error   { background: #fdf0f0; color: #a33;    border: 1px solid #f5c6c6; }
  .status-box.loading { background: var(--sprout); color: var(--bark); border: 1px solid rgba(140,106,93,0.2); }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    color: rgba(67,52,48,0.4);
    font-size: 0.9rem;
  }

  /* Tabs */
  .tab-bar {
    display: flex;
    gap: 0.25rem;
    background: #fff;
    border: 1px solid rgba(140,106,93,0.15);
    border-radius: 12px;
    padding: 0.35rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 10px rgba(67,52,48,0.05);
  }
  .tab-btn {
    flex: 1;
    padding: 0.55rem 1rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: rgba(67,52,48,0.5);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .tab-btn.active {
    background: var(--oak);
    color: #fff;
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* Image management */
  .img-cards { display: flex; flex-direction: column; gap: 1.25rem; }
  .img-card { background: #fff; border: 1px solid rgba(140,106,93,0.15); border-radius: 12px; overflow: hidden; box-shadow: 0 2px 10px rgba(67,52,48,0.05); }
  .img-card-header { padding: 1rem 1.5rem 0.75rem; border-bottom: 1px solid rgba(140,106,93,0.1); }
  .img-card-name { font-size: 0.78rem; font-family: monospace; background: rgba(140,106,93,0.08); color: var(--bark); padding: 0.2rem 0.5rem; border-radius: 4px; display: inline-block; margin-bottom: 0.25rem; }
  .img-card-desc { font-size: 0.85rem; color: var(--oak); opacity: 0.75; margin-top: 0.2rem; }
  .img-card-body { display: grid; grid-template-columns: 160px 1fr; gap: 1.25rem; padding: 1.25rem 1.5rem; align-items: start; }
  @media (max-width: 600px) { .img-card-body { grid-template-columns: 1fr; } }
  .img-preview { width: 160px; height: 90px; border-radius: 8px; object-fit: cover; border: 1px solid rgba(140,106,93,0.15); display: block; }
  .img-preview-empty { width: 160px; height: 90px; border-radius: 8px; background: rgba(140,106,93,0.06); border: 1px dashed rgba(140,106,93,0.25); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: rgba(67,52,48,0.35); }
  .img-url-section label { display: block; font-size: 0.78rem; font-weight: 600; color: var(--oak); margin-bottom: 0.4rem; opacity: 0.85; }
  .img-url-input { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid rgba(140,106,93,0.25); border-radius: 7px; font-size: 0.8rem; background: var(--rice); color: var(--bark); font-family: monospace; box-sizing: border-box; transition: border-color 0.2s; }
  .img-url-input:focus { outline: none; border-color: var(--oak); background: #fff; }
  .img-url-input.changed { border-color: #c8a96e; background: #fffdf5; }
  .img-upload-btn { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.6rem; font-size: 0.78rem; padding: 0.35rem 0.75rem; border: 1px solid rgba(140,106,93,0.3); border-radius: 6px; background: transparent; color: var(--oak); cursor: pointer; transition: background 0.15s; }
  .img-upload-btn:hover { background: var(--sprout); }
  .img-upload-input { display: none; }
  .img-upload-hint { font-size: 0.75rem; color: rgba(67,52,48,0.45); margin-top: 0.35rem; }

  /* SEO fields */
  .seo-page-card {
    background: #fff;
    border: 1px solid rgba(140,106,93,0.15);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 2px 10px rgba(67,52,48,0.05);
