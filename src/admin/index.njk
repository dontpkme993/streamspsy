    // ── Helpers ───────────────────────────────────────────
    function toB64(str) {
      return btoa(unescape(encodeURIComponent(str)));
    }
    function fromB64(b64) {
      return decodeURIComponent(escape(atob(b64.replace(/\n/g, ''))));
    }
    function getToken() {
      return document.getElementById('gh-token').value.trim();
    }
    function setStatus(id, type, msg) {
      const el = document.getElementById(id);
      el.className = 'status-box show ' + type;
      el.textContent = msg;
    }
    function clearStatus(id) {
      const el = document.getElementById(id);
      el.className = 'status-box';
      el.textContent = '';
    }

    // ── Render form groups ────────────────────────────────
    function renderGroups() {
      const container = document.getElementById('field-groups');
      container.innerHTML = GROUPS.map(group => {
        const fields = group.fields.map(f => {
          const isLong = f.long;
          const isFull = f.full || isLong;
          const el = isLong
            ? `<textarea id="field-${f.key}" rows="2" placeholder="${f.label}…"></textarea>`
            : `<input type="text" id="field-${f.key}" placeholder="${f.label}…" />`;
          return `<div class="field-item${isFull ? ' field-full' : ''}">
            <label for="field-${f.key}">${f.label}</label>
            ${el}
          </div>`;
        }).join('');

        return `<details class="field-group" id="group-${group.id}">
          <summary class="group-summary">
            <span class="group-title">${group.label}</span>
            <span class="group-meta">${group.fields.length} 個欄位</span>
            <span class="group-chevron">▼</span>
          </summary>
          <div class="group-fields">${fields}</div>
        </details>`;
      }).join('');

      // Track changes
      container.querySelectorAll('input, textarea').forEach(el => {
        el.addEventListener('input', () => {
          el.classList.add('changed');
          markDirty();
        });
      });
    }

    function markDirty() {
      isDirty = true;
      const info = document.getElementById('save-info');
      if (info) { info.textContent = '有未儲存的變更'; info.className = 'save-info dirty'; }
    }
    function markClean() {
      isDirty = false;
      const info = document.getElementById('save-info');
      if (info) { info.textContent = '已是最新版本'; info.className = 'save-info'; }
    }

    // ── Populate fields from data ─────────────────────────
    function populateFields(data) {
      GROUPS.forEach(group => {
        group.fields.forEach(f => {
          const el = document.getElementById('field-' + f.key);
          if (el && data[f.key] !== undefined) {
            el.value = data[f.key];
            el.classList.remove('changed');
          }
        });
      });
      // Open first group by default
      const first = document.querySelector('.field-group');
      if (first) first.open = true;
    }

    // ── Collect fields to data object ─────────────────────
    function collectFields() {
      const data = {};
      GROUPS.forEach(group => {
        group.fields.forEach(f => {
          const el = document.getElementById('field-' + f.key);
          if (el) data[f.key] = el.value;
        });
      });
      return data;
    }

    // ── GitHub API ────────────────────────────────────────
    async function loadFile() {
      const token = getToken();
      if (!token) { setStatus('load-status', 'error', '請先輸入 Token'); return; }

      document.getElementById('btn-load').disabled = true;
      setStatus('load-status', 'loading', '載入中…');

      try {
        const res = await fetch(
          `${API_BASE}/repos/${REPO}/contents/${FILE_PATH}`,
          { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' } }
        );
        if (res.status === 401) throw new Error('Token 無效或已過期');
        if (res.status === 403) throw new Error('Token 權限不足，需要 Contents: Read and write');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = await res.json();
        currentSha   = json.sha;
        originalData = JSON.parse(fromB64(json.content));
        populateFields(originalData);
        localStorage.setItem(LS_TOKEN, token);
        markClean();

        // 同時載入 SEO 設定
        if (typeof loadSeoFiles === 'function') loadSeoFiles(token);

        setStatus('load-status', 'success', '✓ 載入成功，請直接修改下方欄位');
      } catch (e) {
        setStatus('load-status', 'error', '載入失敗：' + e.message);
      } finally {
        document.getElementById('btn-load').disabled = false;
      }
    }

    async function saveFile() {
      const token = getToken();
      if (!token)     { setStatus('save-status', 'error', '請先載入資料');    return; }
      if (!currentSha){ setStatus('save-status', 'error', '請先按「載入目前設定」'); return; }

      document.getElementById('btn-save').disabled = true;
      setStatus('save-status', 'loading', '儲存中，請稍候…');

      try {
        const newData    = collectFields();
        const newContent = toB64(JSON.stringify(newData, null, '\t'));

        const res = await fetch(
          `${API_BASE}/repos/${REPO}/contents/${FILE_PATH}`,
          {
            method: 'PUT',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept':        'application/vnd.github+json',
              'Content-Type':  'application/json',
            },
            body: JSON.stringify({
              message: 'Update UI text via admin panel',
              content: newContent,
              sha:     currentSha,
            })
          }
        );

        if (res.status === 401) throw new Error('Token 無效或已過期');
        if (res.status === 403) throw new Error('Token 權限不足');
        if (res.status === 409) throw new Error('檔案已被其他人修改，請重新載入後再存');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const result  = await res.json();
        currentSha    = result.content.sha;
        originalData  = newData;

        // Clear changed indicators
        document.querySelectorAll('input.changed, textarea.changed')
          .forEach(el => el.classList.remove('changed'));
        markClean();
        setStatus('save-status', 'success', '✓ 儲存成功！GitHub Actions 正在重新 build 網站，約 1～3 分鐘後上線。');
      } catch (e) {
        setStatus('save-status', 'error', '儲存失敗：' + e.message);
      } finally {
        document.getElementById('btn-save').disabled = false;
      }
    }

    // ── Init ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
      renderGroups();

      // Restore token
      const saved = localStorage.getItem(LS_TOKEN);
      if (saved) document.getElementById('gh-token').value = saved;

      // Bind buttons
      document.getElementById('btn-load').addEventListener('click', loadFile);
      document.getElementById('btn-save').addEventListener('click', saveFile);
      document.getElementById('btn-save-token').addEventListener('click', () => {
        const t = getToken();
        if (!t) return alert('請先輸入 Token');
        localStorage.setItem(LS_TOKEN, t);
        setStatus('load-status', 'success', 'Token 已儲存');
      });
      document.getElementById('btn-clear-token').addEventListener('click', () => {
        localStorage.removeItem(LS_TOKEN);
        document.getElementById('gh-token').value = '';
        setStatus('load-status', 'success', 'Token 已清除');
      });

      // Warn before leaving with unsaved changes
      window.addEventListener('beforeunload', e => {
        if (isDirty) { e.preventDefault(); e.returnValue = ''; }
      });

      // Tab switching
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById(btn.dataset.tab).classList.add('active');
        });
      });
    });

  })();
  </script>

  <script>
  // ── SEO Tab ──────────────────────────────────────────
  (function () {
    const REPO     = 'dontpkme993/streamspsy';
    const API_BASE = 'https://api.github.com';
    const LS_TOKEN = 'admin_gh_token';

    const SEO_PAGES = [
      { label: '首頁',      path: 'src/index.njk' },
      { label: '諮商預約',  path: 'src/booking.njk' },
      { label: '專欄文章',  path: 'src/articles.njk' },
      { label: '聲音與著作', path: 'src/media.njk' },
      { label: '諮商講座',  path: 'src/events.njk' },
      { label: '關於我們',  path: 'src/about.njk' },
      { label: '牌卡',      path: 'src/cards.njk' },
    ];

    // sha and original content per page
    const pageState = {};

    function getToken() {
      return document.getElementById('gh-token').value.trim();
    }

    // 公開供主 script 呼叫
    window.loadSeoFiles = async function(token) {
      return _loadSeoFiles(token || getToken());
    };

    function extractFrontmatter(content, key) {
      const m = content.match(new RegExp('^' + key + ':\\s*(.+)$', 'm'));
      return m ? m[1].trim() : '';
    }

    function replaceFrontmatter(content, key, value) {
      return content.replace(
        new RegExp('^(' + key + ':\\s*)(.+)$', 'm'),
        '$1' + value
      );
    }

    async function _loadSeoFiles(token) {
      if (!token) { setSeoStatus('error', '請先輸入 Token'); return; }

      setSeoStatus('loading', 'SEO 載入中…');

      try {
        await Promise.all(SEO_PAGES.map(async page => {
          const res = await fetch(
            `${API_BASE}/repos/${REPO}/contents/${page.path}`,
            { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' } }
          );
          if (!res.ok) throw new Error(`${page.label} HTTP ${res.status}`);
          const json = await res.json();
          const content = decodeURIComponent(escape(atob(json.content.replace(/\n/g, ''))));
          pageState[page.path] = { sha: json.sha, content };

          const key = page.path.replace(/[/.]/g, '_');
          const titleEl = document.getElementById('seo_title_' + key);
          const descEl  = document.getElementById('seo_desc_'  + key);
          if (titleEl) titleEl.value = extractFrontmatter(content, 'title');
          if (descEl)  descEl.value  = extractFrontmatter(content, 'description');
        }));

        setSeoStatus('success', '✓ SEO 載入成功');
        document.getElementById('btn-seo-save').disabled = false;
      } catch (e) {
        setSeoStatus('error', 'SEO 載入失敗：' + e.message);
      }
    }

    async function saveSeoFiles() {
      const token = getToken();
      if (!token) { setSeoStatus('error', '請先輸入 Token'); return; }

      document.getElementById('btn-seo-save').disabled = true;
      setSeoStatus('loading', '儲存中…');

      try {
        // 循序儲存，避免並行 PUT 產生 409
        for (const page of SEO_PAGES) {
          const state = pageState[page.path];
          if (!state) continue;

          const key = page.path.replace(/[/.]/g, '_');
          const newTitle = document.getElementById('seo_title_' + key)?.value || '';
          const newDesc  = document.getElementById('seo_desc_'  + key)?.value || '';

          let newContent = replaceFrontmatter(state.content, 'title', newTitle);
          newContent     = replaceFrontmatter(newContent,    'description', newDesc);

          if (newContent === state.content) continue; // no change

          // 儲存前重新 GET 最新 SHA
          const freshRes = await fetch(
            `${API_BASE}/repos/${REPO}/contents/${page.path}`,
            { headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' } }
          );
          if (!freshRes.ok) throw new Error(`${page.label} 讀取失敗 HTTP ${freshRes.status}`);
          const freshJson = await freshRes.json();

          const encoded = btoa(unescape(encodeURIComponent(newContent)));
          const res = await fetch(
            `${API_BASE}/repos/${REPO}/contents/${page.path}`,
            {
              method: 'PUT',
              headers: {
                'Authorization': `Bearer ${token}`,
                'Accept': 'application/vnd.github+json',
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                message: `Update SEO meta for ${page.label}`,
                content: encoded,
                sha: freshJson.sha,
              })
            }
          );
          if (!res.ok) throw new Error(`${page.label} 儲存失敗 HTTP ${res.status}`);
          const result = await res.json();
          state.sha     = result.content.sha;
          state.content = newContent;
        }

        setSeoStatus('success', '✓ 儲存成功！網站將自動重新 build。');
      } catch (e) {
        setSeoStatus('error', '儲存失敗：' + e.message);
      } finally {
        document.getElementById('btn-seo-save').disabled = false;
      }
    }

    function setSeoStatus(type, msg) {
      const el = document.getElementById('seo-status');
      el.className = 'status-box show ' + type;
      el.textContent = msg;
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-seo-save').addEventListener('click', saveSeoFiles);
    });
  })();
  </script>
