---
layout: base.njk
title: 編輯者後台｜溪水邊
description: 溪水邊內部管理頁面
permalink: /admin/
eleventyExcludeFromCollections: true
pageStyle: |
  .admin-wrap {
    max-width: 560px;
    margin: 4rem auto;
    padding: 0 1.5rem 4rem;
  }
  .admin-card {
    background: #fff;
    border: 1px solid rgba(140,106,93,0.15);
    border-radius: 12px;
    padding: 2rem 2rem 2.4rem;
    box-shadow: 0 2px 12px rgba(67,52,48,0.06);
  }
  .admin-card h1 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
  }
  .admin-card .subtitle {
    font-size: 0.875rem;
    color: var(--oak);
    opacity: 0.7;
    margin-bottom: 2rem;
  }
  .field { margin-bottom: 1.4rem; }
  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--oak);
    margin-bottom: 0.4rem;
  }
  .field input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(140,106,93,0.3);
    border-radius: 8px;
    font-size: 0.9rem;
    background: var(--rice);
    color: var(--bark);
    font-family: monospace;
    letter-spacing: 0.04em;
    transition: border-color 0.2s;
  }
  .field input:focus {
    outline: none;
    border-color: var(--oak);
  }
  .field .hint {
    font-size: 0.78rem;
    color: var(--oak);
    opacity: 0.6;
    margin-top: 0.3rem;
  }
  .btn-deploy {
    width: 100%;
    padding: 0.8rem 1rem;
    background: var(--oak);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }
  .btn-deploy:hover { background: var(--bark); }
  .btn-deploy:disabled { opacity: 0.5; cursor: not-allowed; }
  .status-box {
    margin-top: 1.4rem;
    padding: 0.9rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    display: none;
  }
  .status-box.success {
    background: #edf7ee;
    color: #2d6a31;
    border: 1px solid #b7dfb9;
    display: block;
  }
  .status-box.error {
    background: #fdf0f0;
    color: #a33;
    border: 1px solid #f5c6c6;
    display: block;
  }
  .status-box.loading {
    background: var(--sprout);
    color: var(--bark);
    border: 1px solid rgba(140,106,93,0.2);
    display: block;
  }
  .divider {
    border: none;
    border-top: 1px solid rgba(140,106,93,0.12);
    margin: 1.8rem 0;
  }
  .token-actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .btn-sm {
    font-size: 0.78rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(140,106,93,0.3);
    border-radius: 6px;
    background: transparent;
    color: var(--oak);
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-sm:hover { background: var(--sprout); }
pageScript: |
  <script>
  (function () {
    const REPO = 'dontpkme993/streamspsy';
    const WORKFLOW = 'notion-deploy.yml';
    const LS_KEY = 'admin_gh_token';

    const tokenInput = document.getElementById('gh-token');
    const deployBtn  = document.getElementById('btn-deploy');
    const statusBox  = document.getElementById('status-box');

    // 載入已存 token
    const saved = localStorage.getItem(LS_KEY);
    if (saved) tokenInput.value = saved;

    document.getElementById('btn-save-token').addEventListener('click', () => {
      const t = tokenInput.value.trim();
      if (!t) return alert('請先輸入 Token');
      localStorage.setItem(LS_KEY, t);
      flash('success', 'Token 已儲存到瀏覽器。');
    });

    document.getElementById('btn-clear-token').addEventListener('click', () => {
      localStorage.removeItem(LS_KEY);
      tokenInput.value = '';
      flash('success', 'Token 已清除。');
    });

    deployBtn.addEventListener('click', async () => {
      const token = tokenInput.value.trim();
      if (!token) {
        flash('error', '請先輸入並儲存 GitHub Token。');
        return;
      }

      deployBtn.disabled = true;
      flash('loading', '正在觸發 build，請稍候...');

      try {
        const res = await fetch(
          `https://api.github.com/repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches`,
          {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Accept': 'application/vnd.github+json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ ref: 'main' }),
          }
        );

        if (res.status === 204) {
          flash('success', '已成功觸發！GitHub Actions 正在 build 中，約 1～3 分鐘後上線。');
        } else if (res.status === 401) {
          flash('error', 'Token 無效或已過期，請重新設定。');
        } else if (res.status === 403) {
          flash('error', 'Token 權限不足，需要 Actions: write 權限。');
        } else {
          const body = await res.json().catch(() => ({}));
          flash('error', `失敗（HTTP ${res.status}）：${body.message || '未知錯誤'}`);
        }
      } catch (e) {
        flash('error', `網路錯誤：${e.message}`);
      } finally {
        deployBtn.disabled = false;
      }
    });

    function flash(type, msg) {
      statusBox.className = 'status-box ' + type;
      statusBox.textContent = msg;
    }
  })();
  </script>
---

<div class="admin-wrap">
  <div class="admin-card">
    <h1>手動觸發網站更新</h1>
    <p class="subtitle">發布新文章後，按下按鈕立即重新 build 網站</p>

    <div class="field">
      <label for="gh-token">GitHub Personal Access Token</label>
      <input type="password" id="gh-token" placeholder="github_pat_…" autocomplete="off" />
      <div class="hint">
        需要 Fine-grained token，權限：<strong>Actions → Read and write</strong><br>
        Token 只存在你的瀏覽器，不會上傳。
      </div>
      <div class="token-actions">
        <button class="btn-sm" id="btn-save-token">儲存 Token</button>
        <button class="btn-sm" id="btn-clear-token">清除 Token</button>
      </div>
    </div>

    <hr class="divider">

    <button class="btn-deploy" id="btn-deploy">立即更新網站</button>

    <div class="status-box" id="status-box"></div>
  </div>
</div>
